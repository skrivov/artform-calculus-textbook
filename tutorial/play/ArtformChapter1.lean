-- ANCHOR: align
structure Align (P Q : OrderedForm) where
  map         : P.cells → Q.cells
  back        : Q.cells → P.cells
  back_map    : ∀ x, back (map x) = x
  map_back    : ∀ y, map (back y) = y
  keeps_order : ∀ x y, P.before x y → Q.before (map x) (map y)
-- ANCHOR_END: align

-- ANCHOR: alpha
def α : Align (glue (rod 2) (rod 3)) (rod 5) where
  map
    | ⟨.L, i⟩ => ⟨i, by omega⟩          -- L0 ↦ 0, L1 ↦ 1
    | ⟨.R, j⟩ => ⟨2 + j, by omega⟩      -- R0 ↦ 2, R1 ↦ 3, R2 ↦ 4
  back i := if h : i < 2 then ⟨.L, ⟨i, h⟩⟩
            else ⟨.R, ⟨i - 2, by omega⟩⟩
  back_map    := by decide
  map_back    := by decide
  keeps_order := by decide
-- ANCHOR_END: alpha

-- ANCHOR: threeeq
example : 2 + 3 = 5 := rfl                          -- a computation

def isGlued : OrderedForm → Prop
  | glue _ _ => True
  | _        => False

example : glue (rod 2) (rod 3) ≠ rod 5 :=           -- an empty type
  fun h => (h ▸ trivial : isGlued (rod 5))

example : Align (glue (rod 2) (rod 3)) (rod 5) := α  -- one value
-- ANCHOR_END: threeeq

-- ANCHOR: noalign
theorem no_align (a : Align (rod 2) (rod 3)) : False := by -- PROOF
  have h := a.map_back
  have : ∀ x y z : Fin 2, x = y ∨ x = z ∨ y = z := by decide
  rcases this (a.back 0) (a.back 1) (a.back 2) with e | e | e
  all_goals
    have := congrArg a.map e
    rw [h, h] at this
    exact absurd this (by decide) -- QED

def Fits (m n : Nat) : Type :=
  (C : OrderedForm) × Align (glue (rod m) C) (rod n)

def threeInFive : Fits 3 5 :=
  ⟨rod 2, -- PROOF
   { map  | ⟨.L, i⟩ => ⟨i, by omega⟩
          | ⟨.R, j⟩ => ⟨3 + j, by omega⟩
     back i := if h : i < 3 then ⟨.L, ⟨i, h⟩⟩
               else ⟨.R, ⟨i - 3, by omega⟩⟩
     back_map := by decide, map_back := by decide,
     keeps_order := by decide }⟩ -- QED
-- ANCHOR_END: noalign

