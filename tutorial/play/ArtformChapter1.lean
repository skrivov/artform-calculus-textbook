/-! ## Time -/

-- ANCHOR: timeform
structure TimeForm where
  n    : Nat
  next : Fin n → Option (Fin n)            -- none: no successor
  inj  : ∀ s t u, next s = some u → next t = some u → s = t

def LinearTime (n : Nat) : TimeForm where
  n := n
  next t := if h : t + 1 < n then some ⟨t + 1, h⟩ else none
  inj s t u h₁ h₂ := by -- PROOF
    have v {s : Fin n} (h : (if h : s + 1 < n then some ⟨s + 1, h⟩ else none) = some u) :
        u.val = s + 1 := by split at h <;> cases h; rfl
    have := v h₁; have := v h₂; ext; omega -- QED

def CycleTime (n : Nat) : TimeForm where
  n := n
  next t := some ⟨(t + 1) % n, Nat.mod_lt _ (by have := t.isLt; omega)⟩
  inj s t u h₁ h₂ := by -- PROOF
    have e := congrArg Fin.val ((Option.some.inj h₁).trans (Option.some.inj h₂).symm)
    simp only at e; ext; have := s.isLt; have := t.isLt
    by_cases a : s.val + 1 = n <;> by_cases b : t.val + 1 = n
    · omega
    · rw [a, Nat.mod_self, Nat.mod_eq_of_lt (by omega)] at e; omega
    · rw [b, Nat.mod_self, Nat.mod_eq_of_lt (by omega)] at e; omega
    · rw [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at e; omega -- QED

structure PointedTimeForm where
  T  : TimeForm
  t₀ : Fin T.n

def PointTime (T : TimeForm) (t₀ : Fin T.n) : PointedTimeForm := ⟨T, t₀⟩
def forgetPoint (P : PointedTimeForm) : TimeForm := P.T
def Clock (L : Nat) (h : 0 < L) : PointedTimeForm :=
  PointTime (CycleTime L) ⟨0, h⟩
-- ANCHOR_END: timeform

-- ANCHOR: tapestry
structure RectTapestry where
  T : TimeForm
  R : OrderedForm                         -- the rows, in order
  V : R.cells → Type                      -- the temporal palette
  e : (r : R.cells) → Fin T.n → V r       -- one thread for every row

def thread (r : Fin 4) (t : Fin 12) : Fin (r + 1) :=
  ⟨t % (r + 1), Nat.mod_lt _ (by omega)⟩

def recurrence : RectTapestry :=
  ⟨CycleTime 12, rod 4, fun r => Fin (r + 1), thread⟩

def name (r : Fin 4) (j : Fin (r + 1)) : Nat := 1 + (r + 1) * r / 2 + j

def column (t : Fin 12) : List Nat :=
  (List.finRange 4).map fun r => name r (thread r t)

example : column 0 = [1, 2, 4, 7] ∧ column 5 = [1, 3, 6, 8] := by decide
example : ((List.finRange 12).map column).Nodup := by decide
example : (values ((r : Fin 4) × Fin (r + 1))).length = 10 := rfl
-- ANCHOR_END: tapestry

-- ANCHOR: spectrum
def Laying := Nat → Nat → Nat         -- phases k and tick t ↦ a phase
attribute [reducible] Laying -- HIDE

def layRec : Laying := fun k t => t % k
def layDiv : Laying := fun k t => k * t / 12

def period (row : Nat → Nat) : Nat :=
  ((List.range 12).map (· + 1)).find? (fun d => 12 % d == 0 &&
      (List.range 12).all fun t => row ((t + d) % 12) == row t)
    |>.getD 12

def spectrum (ℓ : Laying) : List Nat :=
  [1, 2, 3, 4].map fun k => period (ℓ k)

example : spectrum layRec = [1, 2, 3, 4]    := by decide
example : spectrum layDiv = [1, 12, 12, 12] := by decide
-- ANCHOR_END: spectrum

-- ANCHOR: ticks
structure Graph where
  State : Type
  Move  : State → State → Type

inductive Path (G : Graph) : G.State → G.State → Nat → Type
  | stay : Path G x x 0
  | step : G.Move x y → Path G y z H → Path G x z (H + 1)

structure TickRealization (G : Graph) (T : PointedTimeForm) where
  q     : G.State → Fin T.T.n                     -- phase projection
  x₀    : G.State
  κ     : {x y : G.State} → G.Move x y → Bool      -- registers a tick?
  start : q x₀ = T.t₀
  law   : ∀ {x y} (a : G.Move x y),
            if κ a then T.T.next (q x) = some (q y) else q y = q x
-- ANCHOR_END: ticks

-- ANCHOR: cyclarchy
def Digits : List Nat → Type
  | []      => Unit
  | N :: Ns => Fin N × Digits Ns
attribute [reducible] Digits -- HIDE

def addCarry : (Ns : List Nat) → Digits Ns → Bool → Digits Ns
  | [],      (),     _ => ()
  | N :: Ns, (a, r), c =>
      if c then
        if h : a + 1 < N then (⟨a + 1, h⟩, r)
        else (⟨0, by omega⟩, addCarry Ns r true)   -- the carry
      else (a, r)

def inc (Ns : List Nat) (d : Digits Ns) : Digits Ns := addCarry Ns d true

def flatten : (Ns : List Nat) → Digits Ns → Nat
  | [],      ()     => 0
  | N :: Ns, (a, r) => a + N * flatten Ns r

example : inc [3, 4] (⟨2, by omega⟩, ⟨0, by omega⟩, ())
          = (⟨0, by omega⟩, ⟨1, by omega⟩, ()) := by decide
example : ∀ d : Digits [3, 4],
    flatten [3, 4] (inc [3, 4] d) = (flatten [3, 4] d + 1) % 12 := by
  decide
-- ANCHOR_END: cyclarchy

-- The seven gear phases at count t, and the count recovered from them.
def gears (t : Nat) : List Nat :=
  [t % 60, t / 10 % 6, t / 10 % 60, t / 60 % 10,
   t / 60 % 60, t / 720 % 5, t / 720 % 60]

example : gears 8264 = [44, 4, 46, 7, 17, 1, 11] := by decide
example (t : Nat) (h : t < 43200) :
    t % 60 + 60 * (t / 60 % 60) + 3600 * (t / 720 % 60 / 5) = t := by
  omega

-- ANCHOR: covering
def covering (L k : Nat) (c : Nat → Nat) : Prop :=
  ∀ t < L, c ((t + 1) % L) = (c t + 1) % k
def grouping (L k : Nat) (p : Nat → Nat) : Prop :=
  ∀ t < L, p ((t + L / k) % L) = (p t + 1) % k
attribute [reducible] covering grouping -- HIDE

example : covering 12 4 (layRec 4) ∧ grouping 12 4 (layDiv 4) := by decide
example : ¬ covering 12 4 (layDiv 4) := by decide
-- ANCHOR_END: covering

structure EventData (T : TimeForm) where
  E     : Type                        -- event identities
  rows  : Nat
  V     : Fin rows → Type
  ρ     : E → Fin rows                -- the row of each event
  θ     : E → Fin T.n                 -- and its position
  value : (e : E) → V (ρ e)

def D (d : Nat → Rat) (i j : Nat) : Rat :=
  ((List.range (j - i)).map fun k => d (i + k)).sum

def d₁ : Nat → Rat := fun _ => 1
def d₂ : Nat → Rat := fun k => [1, 2, 1, 4].getD k 0

example : D d₁ 0 4 = 4 ∧ D d₂ 0 4 = 8 ∧ D d₂ 0 2 = 3 ∧ D d₂ 2 4 = 5 := by
  decide +kernel

-- The calibration of Figure 1.38 and its elapsed readout.
def X : List Int := [0, 1, 2, 3, 4]               -- source readings
def Y : List Int := [0, 1000, 2001, 3000, 4001]   -- reference readings

def calibrated (ρ ε : Int) : Prop :=
  ∀ i < 5, ∀ j < 5, ((Y[j]! - Y[i]!) - ρ * (X[j]! - X[i]!)).natAbs ≤ ε
attribute [reducible] calibrated -- HIDE

structure CalibrationRecord where
  ρ    : Int
  ε    : Int
  cert : calibrated ρ ε                -- the certificate is a proof

def ourRecord : CalibrationRecord := ⟨1000, 1, by decide⟩

def elapsed (r : CalibrationRecord) (e f : Nat) : Int × Int :=
  (r.ρ * (X[f]! - X[e]!) - r.ε, r.ρ * (X[f]! - X[e]!) + r.ε)

example : elapsed ourRecord 1 4 = (2999, 3001) := by decide

/-! ## Meaning -/

-- ANCHOR: profile
structure Profile (Src : Type) where
  End      : Type                       -- what a meaning may produce
  Realizer : Type                       -- the rules that may produce it
  produces : Realizer → Src → End → Prop
  law      : Realizer → Prop

structure IntWit (C : Profile Src) (F : Src) (θ : C.End) where
  realizer : C.Realizer
  cert     : C.law realizer ∧ C.produces realizer F θ

def Sem (Γ : I → Profile Src) (F : Src) : Type :=
  (i : I) × (θ : (Γ i).End) × IntWit (Γ i) F θ

def PointedInt (Γ : I → Profile Src) : Type := (F : Src) × Sem Γ F
-- ANCHOR_END: profile

-- ANCHOR: disciplines
def Palette := List Nat                     -- the row sizes of the theme
def P : Palette := [1, 2, 3, 4]

def Strung := Fin 4 → Fin 12 → Nat         -- four wires, twelve rungs

def lay (ℓ : Laying) (F : Palette) : Strung := fun r t => ℓ (F.getD r 0) t

def clockLaw (ℓ : Laying) : Prop :=
  ∀ k ∈ [1, 2, 3, 4], covering 12 k (ℓ k) ∧ ∀ t < 12, ℓ k t < k
def stringLaw (ℓ : Laying) : Prop :=
  ∀ k ∈ [1, 2, 3, 4], grouping 12 k (ℓ k) ∧ ∀ t < 12, ℓ k t < k
attribute [reducible] clockLaw stringLaw -- HIDE

def profile (law : Laying → Prop) (spec : List Nat) :
    Profile Palette where
  End      := Strung
  Realizer := Laying
  produces ℓ F θ := θ = lay ℓ F ∧ spectrum ℓ = spec
  law      := law

def Crec := profile clockLaw  [1, 2, 3, 4]
def Cdiv := profile stringLaw [1, 12, 12, 12]

def wRec : IntWit Crec P (lay layRec P) :=
  ⟨layRec, (by decide : clockLaw layRec), rfl, by decide⟩
def wDiv : IntWit Cdiv P (lay layDiv P) :=
  ⟨layDiv, (by decide : stringLaw layDiv), rfl, by decide⟩

inductive Discipline | clock | string

def Γ : Discipline → Profile Palette
  | .clock  => Crec
  | .string => Cdiv

def moves : List (Sem Γ P) := [⟨.clock, _, wRec⟩, ⟨.string, _, wDiv⟩]

theorem no_move : IntWit Crec P (lay layDiv P) → False -- PROOF
  | ⟨ℓ, law, hθ, _⟩ => by
    have h₀ := congrFun (congrFun hθ 1) 0      -- the row of two at tick 0
    have h₁ := congrFun (congrFun hθ 1) 1      -- and at tick 1
    have c := (law 2 (by decide)).1 0 (by decide)
    simp [lay, layDiv, P] at h₀ h₁ c
    omega -- QED
-- ANCHOR_END: disciplines

/-! ## Spaces and states -/

-- ANCHOR: canvas
structure Canvas where
  Cell     : Type
  dim      : Cell → Nat
  face     : Cell → Cell → Prop        -- a is an immediate face of b
  raises   : ∀ a b, face a b → dim b = dim a + 1
  boundary : Cell → Prop                -- the declared outer boundary
  closed   : ∀ a b, face a b → boundary b → boundary a

inductive Dim | vertex | edge | face

def SquareGrid (m n : Nat) : Dim → Type
  | .vertex => Fin (m + 1) × Fin (n + 1)
  | .edge   => Fin m × Fin (n + 1) ⊕ Fin (m + 1) × Fin n
  | .face   => Fin m × Fin n
-- ANCHOR_END: canvas

instance : Listed Dim := ⟨[.vertex, .edge, .face], fun d => by cases d <;> simp⟩
instance : (d : Dim) → Listed (SquareGrid m n d)
  | .vertex => inferInstanceAs (Listed (Fin _ × Fin _))
  | .edge   => inferInstanceAs (Listed (Fin _ × Fin _ ⊕ Fin _ × Fin _))
  | .face   => inferInstanceAs (Listed (Fin _ × Fin _))

-- ANCHOR: board
def count (A : Type) [Listed A] : Nat := (values A).length

example : count (SquareGrid 8 8 .vertex) = 81  := rfl
example : count (SquareGrid 8 8 .edge)   = 144 := rfl
example : count (SquareGrid 8 8 .face)   = 64  := rfl

def Square := Fin 8 × Fin 8               -- (file, rank): a1 is (0, 0)
attribute [reducible] Square -- HIDE

def dark (s : Square) : Bool := (s.1.val + s.2.val) % 2 == 0

def shareEdge (s t : Square) : Bool :=
  (s.1 == t.1 && (s.2.val + 1 == t.2.val || t.2.val + 1 == s.2.val)) ||
  (s.2 == t.2 && (s.1.val + 1 == t.1.val || t.1.val + 1 == s.1.val))

structure Domino (a b : Square) : Prop where
  link : shareEdge a b = true

example : Domino (6, 6) (7, 6) := ⟨rfl⟩          -- g7 and h7
example : Domino (3, 5) (4, 6) → False := nofun   -- d6 and e7
-- ANCHOR_END: board

example : count ((d : Dim) × SquareGrid 8 8 d) = 289 := by decide +kernel

-- ANCHOR: state
def Table := Square → Fin 13             -- six white, six black, empty
attribute [reducible] Table -- HIDE

def State (Legal : Table → Prop) : Type := { s : Table // Legal s }

example (Legal : Table → Prop) (s : Table) (p q : Legal s) :
    (⟨s, p⟩ : State Legal) = ⟨s, q⟩ := rfl
-- ANCHOR_END: state

def toggle (i : Fin 3) (s : Fin 3 → Bool) : Fin 3 → Bool :=
  fun j => if j = i then !s j else s j

def s₀ : Fin 3 → Bool | 0 => true | _ => false
def s₁ : Fin 3 → Bool | 2 => false | _ => true

example : toggle 1 s₀ = s₁ := by decide

/-! ## Scripts and roles -/

-- ANCHOR: script
structure Script (A B : Type) where
  ops : List String                    -- the operations it retains
  act : A → B                          -- its action on states

def Script.comp (g : Script B C) (f : Script A B) : Script A C :=
  ⟨f.ops ++ g.ops, g.act ∘ f.act⟩

def τ (m n : Nat) : Script (Fin m × Fin n) (Fin n × Fin m) :=
  ⟨["transpose"], fun (i, j) => (j, i)⟩

example : ((τ 3 2).comp (τ 2 3)).act = id := rfl
example : ((τ 3 2).comp (τ 2 3)).ops = ["transpose", "transpose"] := rfl

structure WhiteToPlay where board : Table
structure BlackToPlay where board : Table

def turnW (move : Table → Table) : Script WhiteToPlay BlackToPlay :=
  ⟨["White's move"], fun s => ⟨move s.board⟩⟩
-- ANCHOR_END: script

-- ANCHOR: badturns
-- Lean refuses this on purpose: Application type mismatch: The last
--     turnW m
--   argument has type
--     Script WhiteToPlay BlackToPlay
--   but is expected to have type
--     Script WhiteToPlay WhiteToPlay
--   in the application
--     (turnW m).comp (turnW m)
example (m : Table → Table) : Script WhiteToPlay BlackToPlay :=
  (turnW m).comp (turnW m)
-- ANCHOR_END: badturns

-- ANCHOR: reading
def lit : Fin 8 → Bool := arc         -- derived data: a rule may read it
#eval tally lit                       -- prints 3, a reading: no rule can
-- ANCHOR_END: reading

/-! ## The remaining formation lines (Table 1.5), not printed -/

def toClock (W : Wheel) : PointedTimeForm :=
  PointTime (CycleTime W.F.size) ⟨W.F.pos W.base, W.F.pos_lt W.base⟩

structure SampleClock (L k : Nat) where
  p   : Nat → Nat                      -- the declared grouping
  law : grouping L k p

structure DurationRecord (H : Nat) where
  d      : Fin H → Rat                 -- one weight per occurrence edge
  nonneg : ∀ i, 0 ≤ d i

structure EventAssociation (E : Type) where
  bracket : E → Nat × Nat              -- two acquired readings
  ϑ       : E → Nat                    -- the model's event coordinate
  sound   : ∀ e, (bracket e).1 ≤ ϑ e ∧ ϑ e ≤ (bracket e).2

structure Frame where
  Pos   : Type
  V     : Pos → Type
  Legal : ((p : Pos) → V p) → Prop

def Frame.Instance (A : Frame) : Type :=
  { s : (p : A.Pos) → A.V p // A.Legal s }

structure PatchWitness (c X : Canvas) where
  map  : { a : c.Cell // c.boundary a } → X.Cell
  dims : ∀ a, X.dim (map a) = c.dim a.1

def attachCell (X c : Canvas) (w : PatchWitness c X) : Canvas where
  Cell := X.Cell ⊕ { a : c.Cell // ¬ c.boundary a }   -- c's interior: new
  dim
    | .inl x => X.dim x
    | .inr a => c.dim a.1
  face
    | .inl x, .inl y => X.face x y
    | .inl x, .inr b => ∃ a, w.map a = x ∧ c.face a.1 b.1
    | .inr a, .inr b => c.face a.1 b.1
    | .inr _, .inl _ => False
  raises a b h := by
    match a, b with
    | .inl x, .inl y => exact X.raises x y h
    | .inl x, .inr b => obtain ⟨a, rfl, h⟩ := h; simp only; rw [w.dims]; exact c.raises _ _ h
    | .inr a, .inr b => exact c.raises _ _ h
    | .inr _, .inl _ => exact h.elim
  boundary                                  -- X's boundary is kept
    | .inl x => X.boundary x
    | .inr _ => False
  closed a b h hb := by
    match a, b with
    | .inl x, .inl y => exact X.closed x y h hb
    | .inl _, .inr _ => exact hb.elim
    | .inr _, .inr _ => exact hb.elim
    | .inr _, .inl _ => exact h.elim

structure RefinementData (X : Canvas) where
  fine   : Canvas
  parent : fine.Cell → X.Cell          -- π, the ancestry of a fine cell

-- The eight symmetries of the square, counted from its incidence.
def adj (i j : Fin 4) : Bool :=
  (i.val + 1) % 4 == j.val || (j.val + 1) % 4 == i.val

def maps : List (Fin 4 → Fin 4) :=
  (List.finRange 4).flatMap fun a => (List.finRange 4).flatMap fun b =>
  (List.finRange 4).flatMap fun c => (List.finRange 4).map fun d =>
    fun i => [a, b, c, d].getD i 0

def symmetry (σ : Fin 4 → Fin 4) : Bool :=
  (List.finRange 4).all fun i => (List.finRange 4).all fun j =>
    (σ i == σ j) == (i == j) && adj (σ i) (σ j) == adj i j

example : (maps.filter symmetry).length = 8 := by decide +kernel
