-- ANCHOR: scripts
def exchange (P Q : OrderedForm) :
    (glue P Q).cells → (glue Q P).cells
  | ⟨.L, p⟩ => ⟨.R, p⟩
  | ⟨.R, q⟩ => ⟨.L, q⟩

def transpose (m n : Nat) :
    (subst (rod m) (rod n)).cells → (subst (rod n) (rod m)).cells
  | (i, j) => (j, i)

example (m n : Nat) : transpose n m ∘ transpose m n = id := rfl

def cut (P Q₁ Q₂ : OrderedForm) :
    (subst P (glue Q₁ Q₂)).cells → (glue (subst P Q₁) (subst P Q₂)).cells
  | (p, ⟨.L, q⟩) => ⟨.L, (p, q)⟩
  | (p, ⟨.R, q⟩) => ⟨.R, (p, q)⟩
-- ANCHOR_END: scripts

def regroup (P Q R : OrderedForm) :
    (glue (glue P Q) R).cells → (glue P (glue Q R)).cells
  | ⟨.L, ⟨.L, p⟩⟩ => ⟨.L, p⟩
  | ⟨.L, ⟨.R, q⟩⟩ => ⟨.R, ⟨.L, q⟩⟩
  | ⟨.R, r⟩       => ⟨.R, ⟨.R, r⟩⟩

example : ∀ x : (glue (rod 2) (rod 3)).cells,
    exchange (rod 3) (rod 2) (exchange (rod 2) (rod 3) x) = x := by decide

