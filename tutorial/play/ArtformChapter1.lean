/-! ## Reading the colon: a finite type lists its values -/

-- ANCHOR: listed
class Listed (A : Type) where
  elems    : List A                 -- the values of A
  complete : ∀ a, a ∈ elems         -- and every value is among them
-- ANCHOR_END: listed

-- Lean decides a statement about every value by running through the list.
instance [Listed α] (p : α → Prop) [DecidablePred p] :
    Decidable (∀ a, p a) :=
  decidable_of_iff (∀ a ∈ Listed.elems, p a)
    ⟨fun h a => h a (Listed.complete a), fun h a _ => h a⟩

instance [Listed α] [DecidableEq β] : DecidableEq (α → β) := fun f g =>
  decidable_of_iff (∀ a, f a = g a) ⟨funext, fun h _ => h ▸ rfl⟩

instance : Listed (Fin n) := ⟨List.finRange n, List.mem_finRange⟩
instance : Listed Unit := ⟨[()], fun _ => List.mem_singleton.2 rfl⟩

instance [Listed α] [Listed β] : Listed (α × β) where
  elems := (Listed.elems : List α).flatMap fun a =>
             (Listed.elems : List β).map fun b => (a, b)
  complete := fun ⟨a, b⟩ => List.mem_flatMap.2
    ⟨a, Listed.complete a, List.mem_map.2 ⟨b, Listed.complete b, rfl⟩⟩

instance {β : α → Type} [Listed α] [∀ a, Listed (β a)] : Listed ((a : α) × β a) where
  elems := (Listed.elems : List α).flatMap fun a =>
             (Listed.elems : List (β a)).map fun b => ⟨a, b⟩
  complete := fun ⟨a, b⟩ => List.mem_flatMap.2
    ⟨a, Listed.complete a, List.mem_map.2 ⟨b, Listed.complete b, rfl⟩⟩

instance {A B : Type} [Listed A] [Listed B] : Listed (A ⊕ B) where
  elems := (Listed.elems : List A).map .inl ++ (Listed.elems : List B).map .inr
  complete
    | .inl a => List.mem_append_left _ (List.mem_map.2 ⟨a, Listed.complete a, rfl⟩)
    | .inr b => List.mem_append_right _ (List.mem_map.2 ⟨b, Listed.complete b, rfl⟩)

-- ANCHOR: tag
inductive Tag | L | R
deriving instance DecidableEq for Tag -- HIDE
-- ANCHOR_END: tag

instance : Listed Tag := ⟨[.L, .R], fun t => by cases t <;> simp⟩

-- A tagged pair over the two tags: listed and compared tag by tag.
instance (priority := high) {β : Tag → Type} [Listed (β .L)] [Listed (β .R)] :
    Listed ((t : Tag) × β t) where
  elems := (Listed.elems : List (β .L)).map (⟨.L, ·⟩)
        ++ (Listed.elems : List (β .R)).map (⟨.R, ·⟩)
  complete
    | ⟨.L, b⟩ => List.mem_append_left _ (List.mem_map.2 ⟨b, Listed.complete b, rfl⟩)
    | ⟨.R, b⟩ => List.mem_append_right _ (List.mem_map.2 ⟨b, Listed.complete b, rfl⟩)

instance {β : Tag → Type} [DecidableEq (β .L)] [DecidableEq (β .R)] :
    DecidableEq ((t : Tag) × β t)
  | ⟨.L, a⟩, ⟨.L, b⟩ => if h : a = b then isTrue (h ▸ rfl)
                        else isFalse (fun e => h (by cases e; rfl))
  | ⟨.R, a⟩, ⟨.R, b⟩ => if h : a = b then isTrue (h ▸ rfl)
                        else isFalse (fun e => h (by cases e; rfl))
  | ⟨.L, _⟩, ⟨.R, _⟩ => isFalse nofun
  | ⟨.R, _⟩, ⟨.L, _⟩ => isFalse nofun

/-! ## Rods: their rules and their laws -/

-- ANCHOR: orderedform
inductive OrderedForm where
  | rod   : Nat → OrderedForm
  | glue  : OrderedForm → OrderedForm → OrderedForm
  | subst : OrderedForm → OrderedForm → OrderedForm
-- ANCHOR_END: orderedform

namespace OrderedForm

-- ANCHOR: cells
def cells : OrderedForm → Type
  | rod n     => Fin n
  | glue P Q  => (t : Tag) × match t with
                               | .L => cells P
                               | .R => cells Q
  | subst P Q => cells P × cells Q
-- ANCHOR_END: cells
attribute [reducible] cells

-- ANCHOR: pos
def size : OrderedForm → Nat
  | rod n     => n
  | glue P Q  => size P + size Q
  | subst P Q => size P * size Q

def pos : (X : OrderedForm) → X.cells → Nat
  | rod _,     i       => i
  | glue P _,  ⟨.L, p⟩ => pos P p
  | glue P Q,  ⟨.R, q⟩ => size P + pos Q q
  | subst P Q, (p, q)  => size Q * pos P p + pos Q q

def before (X : OrderedForm) (a b : X.cells) : Prop := X.pos a < X.pos b
attribute [reducible] before -- HIDE

example (P Q : OrderedForm) : (glue P Q).size = P.size + Q.size := rfl
-- ANCHOR_END: pos

theorem pos_lt : ∀ (X : OrderedForm) (x : X.cells), X.pos x < X.size
  | rod _,     i       => i.isLt
  | glue P Q,  ⟨.L, p⟩ => by have := pos_lt P p; simp only [pos, size]; omega
  | glue P Q,  ⟨.R, q⟩ => by have := pos_lt Q q; simp only [pos, size]; omega
  | subst P Q, (p, q)  => by
      have hp := pos_lt P p; have hq := pos_lt Q q
      simp only [pos, size]
      have : Q.size * (P.pos p + 1) ≤ Q.size * P.size := Nat.mul_le_mul_left _ hp
      rw [Nat.mul_comm P.size, Nat.mul_add] at *; omega

-- ANCHOR: rodlaws
theorem pos_inj : ∀ (X : OrderedForm) (a b : X.cells),
    X.pos a = X.pos b → a = b -- PROOF
  | rod _,     i,       j,       h => Fin.ext h
  | glue P Q,  ⟨.L, p⟩, ⟨.L, p'⟩, h => by rw [pos_inj P p p' h]
  | glue P Q,  ⟨.R, q⟩, ⟨.R, q'⟩, h => by
      simp only [pos] at h; rw [pos_inj Q q q' (by omega)]
  | glue P Q,  ⟨.L, p⟩, ⟨.R, q⟩,  h => by
      have := pos_lt P p; simp only [pos] at h; omega
  | glue P Q,  ⟨.R, q⟩, ⟨.L, p⟩,  h => by
      have := pos_lt P p; simp only [pos] at h; omega
  | subst P Q, (p, q),  (p', q'), h => by
      simp only [pos] at h
      have hq := pos_lt Q q; have hq' := pos_lt Q q'
      have e₁ : P.pos p = P.pos p' := by
        have := congrArg (· / Q.size) h
        rwa [Nat.mul_add_div (by omega), Nat.mul_add_div (by omega),
          Nat.div_eq_of_lt hq, Nat.div_eq_of_lt hq'] at this
      have e₂ : Q.pos q = Q.pos q' := by rw [e₁] at h; omega
      rw [pos_inj P p p' e₁, pos_inj Q q q' e₂] -- QED

theorem linear (X : OrderedForm) (a b : X.cells) :
    a ≠ b → X.before a b ∨ X.before b a := fun ne => by -- PROOF
  have : X.pos a ≠ X.pos b := fun h => ne (pos_inj X a b h)
  omega -- QED
-- ANCHOR_END: rodlaws

end OrderedForm
open OrderedForm

