import Mathlib.Data.Fintype.Basic

/-!
# The five roles, their levels, and the dependency policy

Section 2 of the paper *Five Roles for Artforms* (`type-theory/paper/`), after
the textbook's §1.9 (`sec:five-roles`, `sec:role-policy`).

* `Role`: the five roles.
* `Grade`: how a datum is used: freely, through a gate that keeps a record, or
  not at all.
* `demand`: the dependency policy, printed as the table of the paper.
* `demand_eq_demandOf_level`: the table is generated by four levels and the
  firewall; `demandOf_eq_demand`: the book's four requirements force it.
* `demand_pathClosed`: no route through a third role recovers a forbidden
  dependency.
* `policySeparates_iff`: the policy tells every two roles apart except
  WITNESS and SCRIPT.
-/

namespace Artform.Roles

/-- The five roles of the textbook's §1.9. -/
inductive Role
  | form
  | presentation
  | witness
  | script
  | rendering
  deriving DecidableEq, Repr

instance : Fintype Role :=
  Fintype.ofList [.form, .presentation, .witness, .script, .rendering] fun r => by
    cases r <;> simp

/-- The grade of a dependency: ordinary use, use through a gate that keeps a
record of what was assumed, and no use at all. -/
inductive Grade
  | free
  | gated
  | absent
  deriving DecidableEq, Repr

instance : Fintype Grade :=
  Fintype.ofList [.free, .gated, .absent] fun g => by cases g <;> simp

namespace Grade

/-- Grades are ordered `free < gated < absent`. -/
def toNat : Grade → ℕ
  | free => 0
  | gated => 1
  | absent => 2

instance : LE Grade := ⟨fun a b => a.toNat ≤ b.toNat⟩
instance : LT Grade := ⟨fun a b => a.toNat < b.toNat⟩

instance (a b : Grade) : Decidable (a ≤ b) :=
  inferInstanceAs (Decidable (a.toNat ≤ b.toNat))

instance (a b : Grade) : Decidable (a < b) :=
  inferInstanceAs (Decidable (a.toNat < b.toNat))

theorem le_def {a b : Grade} : a ≤ b ↔ a.toNat ≤ b.toNat := Iff.rfl

theorem lt_def {a b : Grade} : a < b ↔ a.toNat < b.toNat := Iff.rfl

theorem toNat_le_two (a : Grade) : a.toNat ≤ 2 := by cases a <;> decide

theorem toNat_injective {a b : Grade} (h : a.toNat = b.toNat) : a = b := by
  cases a <;> cases b <;> first | rfl | cases h

/-- A path of two dependencies has the larger grade (the product `⊗`). -/
def seq (a b : Grade) : Grade := if a.toNat ≤ b.toNat then b else a

/-- Of two paths, the smaller grade counts (the sum `⊕`). -/
def alt (a b : Grade) : Grade := if a.toNat ≤ b.toNat then a else b

@[simp] theorem toNat_seq (a b : Grade) : (seq a b).toNat = max a.toNat b.toNat := by
  unfold seq; split <;> omega

@[simp] theorem toNat_alt (a b : Grade) : (alt a b).toNat = min a.toNat b.toNat := by
  unfold alt; split <;> omega

theorem le_absent (a : Grade) : a ≤ absent := by cases a <;> decide

theorem free_le (a : Grade) : free ≤ a := by cases a <;> decide

/-- `(Grade, alt, absent, seq, free)` is an idempotent commutative semiring. -/
theorem semiring_laws :
    (∀ a b c : Grade, alt (alt a b) c = alt a (alt b c)) ∧
    (∀ a b : Grade, alt a b = alt b a) ∧
    (∀ a : Grade, alt a a = a) ∧
    (∀ a : Grade, alt absent a = a) ∧
    (∀ a b c : Grade, seq (seq a b) c = seq a (seq b c)) ∧
    (∀ a b : Grade, seq a b = seq b a) ∧
    (∀ a : Grade, seq free a = a) ∧
    (∀ a : Grade, seq absent a = absent) ∧
    (∀ a b c : Grade, seq a (alt b c) = alt (seq a b) (seq a c)) := by
  decide

end Grade

open Grade

/-- The level of a role: the frame's carrier, the frame's carried structure,
the instance, and the display. WITNESS and SCRIPT share the instance level. -/
def Role.level : Role → ℕ
  | .form => 0
  | .presentation => 1
  | .witness => 2
  | .script => 2
  | .rendering => 3

/-- The dependency policy, as the paper prints it. `demand σ ρ` is the least
grade at which a datum of role `ρ` may depend on a datum of role `σ`. -/
def demand : Role → Role → Grade
  | .form, _ => .free
  | .presentation, .form => .gated
  | .presentation, _ => .free
  | .witness, .form => .gated
  | .witness, .presentation => .gated
  | .witness, _ => .free
  | .script, .form => .gated
  | .script, .presentation => .gated
  | .script, _ => .free
  | .rendering, .rendering => .free
  | .rendering, _ => .absent

/-- The policy generated by a level map: free from a lower or equal level,
through a gate from a higher one, and never out of a reading. -/
def demandOf (ℓ : Role → ℕ) (σ ρ : Role) : Grade :=
  if σ = .rendering ∧ ρ ≠ .rendering then .absent
  else if ℓ σ ≤ ℓ ρ then .free else .gated

/-- The table is generated by the four levels and the firewall. -/
theorem demand_eq_demandOf_level : demand = demandOf Role.level := by
  funext σ ρ; cases σ <;> cases ρ <;> rfl

/-- The book's four requirements on a level map:
* nothing may depend on a reading, and readings may depend on everything;
* the frame (form and presentation) does not change while an instance runs:
  witnesses and scripts lie above it;
* a form does not depend on how it is addressed: presentation lies above form;
* a certificate may mention a move, and a guarded move takes its certificate:
  witnesses and scripts share a level. -/
structure Requirements (ℓ : Role → ℕ) : Prop where
  readings_on_top : ∀ σ, σ ≠ .rendering → ℓ σ < ℓ .rendering
  frame_below_instance :
    ℓ .form < ℓ .witness ∧ ℓ .form < ℓ .script ∧
    ℓ .presentation < ℓ .witness ∧ ℓ .presentation < ℓ .script
  form_below_presentation : ℓ .form < ℓ .presentation
  instance_level : ℓ .witness = ℓ .script

theorem requirements_level : Requirements Role.level where
  readings_on_top σ h := by cases σ <;> simp_all [Role.level]
  frame_below_instance := by decide
  form_below_presentation := by decide
  instance_level := rfl

/-- Any level map meeting the four requirements generates the book's policy. -/
theorem demandOf_eq_demand {ℓ : Role → ℕ} (h : Requirements ℓ) : demandOf ℓ = demand := by
  obtain ⟨hr, ⟨h1, h2, h3, h4⟩, h5, h6⟩ := h
  have r1 := hr .form (by decide)
  have r2 := hr .presentation (by decide)
  have r3 := hr .witness (by decide)
  have r4 := hr .script (by decide)
  funext σ ρ
  cases σ <;> cases ρ <;> simp [demandOf, demand] <;> omega

/-- Path closure: a direct dependency demands no more than any route through a
third role. -/
def PathClosed (D : Role → Role → Grade) : Prop :=
  ∀ σ τ ρ, D σ ρ ≤ seq (D σ τ) (D τ ρ)

theorem demand_pathClosed : PathClosed demand := by
  unfold PathClosed; decide

theorem demand_self (σ : Role) : demand σ σ = .free := by
  cases σ <;> rfl

/-- The policy tells `σ` and `τ` apart when some role depends on them, or they
on it, with different demands. -/
def PolicySeparates (σ τ : Role) : Prop :=
  ∃ κ, demand σ κ ≠ demand τ κ ∨ demand κ σ ≠ demand κ τ

instance (σ τ : Role) : Decidable (PolicySeparates σ τ) := by
  unfold PolicySeparates; infer_instance

/-- The policy tells every two distinct roles apart, except WITNESS and SCRIPT. -/
theorem policySeparates_iff (σ τ : Role) :
    PolicySeparates σ τ ↔
      σ ≠ τ ∧ ¬(σ = .witness ∧ τ = .script) ∧ ¬(σ = .script ∧ τ = .witness) := by
  revert σ τ; decide

/-- WITNESS and SCRIPT have the same row and the same column. -/
theorem witness_script_same_policy (κ : Role) :
    demand .witness κ = demand .script κ ∧ demand κ .witness = demand κ .script := by
  cases κ <;> decide

end Artform.Roles
