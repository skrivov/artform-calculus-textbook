import ArtformTextbook.Ch03.Defs.Cube

/-!
# Geometric parts and construction records (*Shapes, parts, and how pieces make a whole*)

Definition 3.5, for the comparison profile of the cube's assembly, which keeps
the grading and the immediate incidence of cells. A canvas of any kind is
compared through its reduct `U`, an incidence canvas.

* `IncidenceCanvas.Embedding`: a structural embedding, an injection of cells
  that keeps dimension and immediate incidence in both directions.
* `PartFamily U X`: a finite index set, the part canvases with their declared
  shape types (Definition 1.12), and a structural embedding of the reduct of
  each part into the reduct of `X`.
* `AssemblyData P`: interface canvases with their maps into two pieces each;
  the identifications they generate; the joined canvas `Q_D`, the maps from the
  pieces, which agree on every interface; and the evidence that the quotient
  is admitted, here that each piece enters the joined canvas without being
  folded.
* `Decomposition U X`: a part family, an assembly record of its parts, and a
  structural isomorphism `θ : Q_D ≅ U X` that identifies the piece maps with
  the embeddings of the parts.

The outer-boundary mark, optional output data in the book, is not modelled:
incidence canvases do not keep it.
-/

namespace Artform

namespace IncidenceCanvas

/-- A structural embedding of incidence canvases: an injection of cells that
keeps the dimension and the immediate-face relation in both directions. -/
structure Embedding (X Y : IncidenceCanvas) where
  /-- The injection of cells. -/
  toFun : X.Cell ↪ Y.Cell
  /-- It keeps dimension. -/
  dim_eq : ∀ a, Y.dim (toFun a) = X.dim a
  /-- It keeps immediate incidence in both directions. -/
  face_iff : ∀ a b, Y.Face (toFun a) (toFun b) ↔ X.Face a b

/-- The identity embedding. -/
def Embedding.refl (X : IncidenceCanvas) : X.Embedding X :=
  ⟨Function.Embedding.refl _, fun _ => rfl, fun _ _ => Iff.rfl⟩

end IncidenceCanvas

/-- **Definition 3.5** (part family, `PartFamily_σ(X)`). For canvases of type `C`
compared through their reducts `U : C → IncidenceCanvas`: a finite index set
`I`, the part canvases `X_i` with their declared shape types, each part an
instance of its shape (Definition 1.12), and the structural embeddings
`j_i : U X_i ↪ U X`. -/
@[book "def:geometric-records-book"]
structure PartFamily {C : Type*} (U : C → IncidenceCanvas) (X : C) where
  /-- The index set `I`. -/
  I : Type
  [fintypeI : Fintype I]
  /-- The part canvases `X_i`. -/
  part : I → C
  /-- The declared shape type of each part, by its representative canvas. -/
  shape : I → IncidenceCanvas
  /-- Each part is an instance of its shape. -/
  isShape : ∀ i, (U (part i)).IsInstance (shape i)
  /-- The structural embeddings `j_i`. -/
  embed : ∀ i, (U (part i)).Embedding (U X)

attribute [instance] PartFamily.fintypeI

/-- The interfaces of an assembly of the pieces `X : I → IncidenceCanvas`: each
interface canvas, with its embeddings into two pieces. -/
structure AssemblyPlan {I : Type} (X : I → IncidenceCanvas) where
  /-- The interfaces. -/
  J : Type
  [fintypeJ : Fintype J]
  /-- The interface canvases. -/
  iface : J → IncidenceCanvas
  /-- The first piece of each interface. -/
  first : J → I
  /-- The second piece of each interface. -/
  second : J → I
  /-- The map of each interface into its first piece. -/
  toFirst : ∀ k, (iface k).Embedding (X (first k))
  /-- The map of each interface into its second piece. -/
  toSecond : ∀ k, (iface k).Embedding (X (second k))

namespace AssemblyPlan

variable {I : Type} {X : I → IncidenceCanvas} (D : AssemblyPlan X)

/-- The identifications the interfaces generate: a cell of an interface is one
cell of the joined canvas, in its first piece and in its second. -/
def Identify (p q : Σ i, (X i).Cell) : Prop :=
  ∃ k c, p = ⟨D.first k, (D.toFirst k).toFun c⟩ ∧ q = ⟨D.second k, (D.toSecond k).toFun c⟩

/-- The equivalence relation generated by the identifications. -/
def setoid : Setoid (Σ i, (X i).Cell) := Relation.EqvGen.setoid D.Identify

/-- Identified cells have one dimension. -/
theorem dim_eq_of_rel {p q : Σ i, (X i).Cell} (h : Relation.EqvGen D.Identify p q) :
    (X p.1).dim p.2 = (X q.1).dim q.2 := by
  induction h with
  | rel p q h =>
    obtain ⟨k, c, rfl, rfl⟩ := h
    exact ((D.toFirst k).dim_eq c).trans ((D.toSecond k).dim_eq c).symm
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

variable [Fintype I]

open Classical in
/-- **Definition 3.5** (joined canvas `Q_D`): the cells of the pieces, with the
identifications that the interfaces generate; the dimension and the
immediate incidence come from the pieces. -/
@[book "def:geometric-records-book"]
noncomputable def joined : IncidenceCanvas where
  Cell := Quotient D.setoid
  fintypeCell := @Quotient.fintype _ _ D.setoid (Classical.decRel _)
  decEqCell := Classical.decEq _
  dim := Quotient.lift (fun p => (X p.1).dim p.2) fun _ _ h => D.dim_eq_of_rel h
  Face P Q := ∃ (i : I) (x y : (X i).Cell),
    P = Quotient.mk _ ⟨i, x⟩ ∧ Q = Quotient.mk _ ⟨i, y⟩ ∧ (X i).Face x y
  face_dim := by
    rintro _ _ ⟨i, x, y, rfl, rfl, h⟩
    exact (X i).face_dim x y h

/-- **Definition 3.5** (the maps from the pieces): each cell of a piece to its
cell of the joined canvas. -/
@[book "def:geometric-records-book"]
def piece (i : I) (c : (X i).Cell) : D.joined.Cell := Quotient.mk D.setoid ⟨i, c⟩

/-- **Definition 3.5** (compatibility): the maps from the pieces agree on every
interface. -/
theorem piece_compatible (k : D.J) (c : (D.iface k).Cell) :
    D.piece (D.first k) ((D.toFirst k).toFun c) = D.piece (D.second k) ((D.toSecond k).toFun c) :=
  Quotient.sound (Relation.EqvGen.rel _ _ ⟨k, c, rfl, rfl⟩)

/-- The quotient is admitted: no piece is folded, each map from a piece being
injective. -/
def Admitted : Prop := ∀ i, Function.Injective (D.piece i)

end AssemblyPlan

/-- **Definition 3.5** (assembly record, `AssemblyData_σ((X_i))`): interface
canvases with their maps into the pieces, which generate the identifications,
together with the evidence that the quotient is admitted. -/
@[book "def:geometric-records-book"]
structure AssemblyData {I : Type} [Fintype I] (X : I → IncidenceCanvas) where
  /-- The interfaces and their maps. -/
  plan : AssemblyPlan X
  /-- The evidence that the quotient is admitted. -/
  admitted : plan.Admitted

/-- **Definition 3.5** (decomposition, `Decomposition_σ(X)`): a part family, an
assembly record of the reducts of its parts, and a structural isomorphism
`θ : Q_D ≅ U X` that identifies each piece map with the embedding `j_i` of its
part. -/
@[book "def:geometric-records-book"]
structure Decomposition {C : Type*} (U : C → IncidenceCanvas) (X : C) where
  /-- The part family. -/
  parts : PartFamily U X
  /-- The assembly record of the reducts of the parts. -/
  assembly : AssemblyData fun i => U (parts.part i)
  /-- The structural isomorphism `θ : Q_D ≅ U X`. -/
  θ : assembly.plan.joined.Iso (U X)
  /-- `θ` identifies the piece maps with the embeddings `j_i`. -/
  piece_eq : ∀ i c, θ.toEquiv (assembly.plan.piece i c) = (parts.embed i).toFun c

/-! ## Non-vacuity -/

/-- Every incidence canvas is decomposed into one part, itself, with no
interface. -/
noncomputable example (X : IncidenceCanvas) : Decomposition id X := by
  let D : AssemblyPlan fun (_ : Unit) => X :=
    ⟨Empty, fun e => e.elim, fun e => e.elim, fun e => e.elim, fun e => e.elim, fun e => e.elim⟩
  have hrel : ∀ p q : Σ _ : Unit, X.Cell, Relation.EqvGen D.Identify p q → p = q := by
    intro p q h
    induction h with
    | rel _ _ h => obtain ⟨k, _⟩ := h; exact k.elim
    | refl => rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  have hmk : ∀ c d : X.Cell, D.piece () c = D.piece () d → c = d := fun c d h => by
    have := hrel _ _ (Quotient.exact h)
    simpa using this
  let e : D.joined.Cell ≃ X.Cell :=
    { toFun := Quotient.lift (fun p => p.2) fun p q h => by rw [hrel p q h]
      invFun := D.piece ()
      left_inv := by
        intro P
        induction P using Quotient.inductionOn with
        | h p => obtain ⟨⟨⟩, c⟩ := p; rfl
      right_inv := fun _ => rfl }
  refine ⟨⟨Unit, fun _ => X, fun _ => X, fun _ => ⟨IncidenceCanvas.Iso.refl X⟩,
    fun _ => IncidenceCanvas.Embedding.refl X⟩, ⟨D, fun _ => hmk⟩, ⟨e, ?_, ?_⟩, fun _ _ => rfl⟩
  · intro P
    induction P using Quotient.inductionOn with
    | h p => obtain ⟨⟨⟩, c⟩ := p; rfl
  · intro P Q
    induction P using Quotient.inductionOn with
    | h p =>
    induction Q using Quotient.inductionOn with
    | h q =>
    obtain ⟨⟨⟩, c⟩ := p
    obtain ⟨⟨⟩, d⟩ := q
    constructor
    · exact fun h => ⟨(), c, d, rfl, rfl, h⟩
    · rintro ⟨⟨⟩, x, y, hx, hy, h⟩
      rw [hmk c x hx, hmk d y hy]
      exact h

end Artform
