import Mathlib.MeasureTheory.MeasurableSpace.Defs
import ArtformTextbook.Meta.Book

/-!
# Infinite report sequences (Section 4.10)

For finite nonempty alphabets `Y_1, Y_2, …` of one continuing protocol, the
book puts `Ω_∞ = ∏_{t ≥ 1} Y_t`, the cylinder `[h]` of each finite prefix `h`,
and the σ-algebra `𝒜_∞ = σ{[h] : h a finite prefix}` that the cylinders
generate. In Lean the alphabets are `Y 0, Y 1, …`, so `Y t` is the book's
`Y_{t+1}`, and `Ω_∞` is the type `(t : ℕ) → Y t` of infinite sequences. A prefix
of length `n` is a word `h : (i : Fin n) → Y i`.
-/

namespace Artform

/-- The cylinder `[h]` of Section 4.10: the infinite sequences of `Ω_∞` that
begin with the finite prefix `h`. -/
def prefixCylinder {Y : ℕ → Type*} {n : ℕ} (h : (i : Fin n) → Y i) : Set ((t : ℕ) → Y t) :=
  {ω | ∀ i : Fin n, ω i = h i}

/-- The σ-algebra `𝒜_∞ = σ{[h] : h a finite prefix}` of Section 4.10 on
`Ω_∞`: the σ-algebra generated by the cylinders of all finite prefixes. -/
@[instance_reducible]
def cylinderAlgebra (Y : ℕ → Type*) : MeasurableSpace ((t : ℕ) → Y t) :=
  MeasurableSpace.generateFrom {s | ∃ (n : ℕ) (h : (i : Fin n) → Y i), s = prefixCylinder h}

end Artform
