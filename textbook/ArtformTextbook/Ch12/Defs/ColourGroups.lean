/-!
# The four colour groups of Chapter 12

The finite colour groups of Chapter 12, each a subgroup of `SU(3)` whose triplet is the
inclusion, so that its character is the trace:

* Model I, the cube group (Section 12.1): the twenty-four signed permutation matrices of
  determinant one, with the triplet `3_r`;
* Model II, the icosahedral group `A₅` (Section 12.3): the sixty rotations of the
  icosahedron, `icoRotations`, with the triplet `3`;
* Refinement I, `C₃ × A₅` (Definition 12.11), a product group with its triplet
  `(ω^j, g) ↦ ω^j g`;
* Refinement II, Valentiner's group `S(1080)` (Section 12.5). The book does not write its
  matrices; here it is constructed as the subgroup of `SU(3)` generated by the triplet image
  of `C₃ × A₅` and one more matrix `F`.

Then the character tables the chapter reads (Figures `fig:mt-s4-characters`,
`fig:mm-a5-characters` and `fig:mm-s1080-classes`), the averages and pairings of class
functions, and the `n`-fold loop.
-/

namespace Artform

open Matrix

/-! ### Two facts about `SU(3)` -/

/-- A scalar `c` with `c c̄ = 1` and `c³ = 1` keeps `SU(3)`. -/
theorem smul_mem_specialUnitaryGroup {c : ℂ} (hc : c * (starRingEnd ℂ) c = 1) (hc3 : c ^ 3 = 1)
    {M : Matrix (Fin 3) (Fin 3) ℂ} (hM : M ∈ specialUnitaryGroup (Fin 3) ℂ) :
    c • M ∈ specialUnitaryGroup (Fin 3) ℂ := by
  rw [mem_specialUnitaryGroup_iff, mem_unitaryGroup_iff] at hM ⊢
  refine ⟨?_, ?_⟩
  · rw [star_smul, smul_mul_smul_comm, hM.1, Complex.star_def, hc, one_smul]
  · rw [det_smul, Fintype.card_fin, hc3, hM.2, one_mul]

/-- A real matrix read as a complex matrix respects products. -/
theorem map_ofReal_mul (R S : Matrix (Fin 3) (Fin 3) ℝ) :
    (R * S).map (fun x : ℝ => (x : ℂ)) =
      R.map (fun x : ℝ => (x : ℂ)) * S.map (fun x : ℝ => (x : ℂ)) :=
  Matrix.map_mul (f := Complex.ofRealHom)

/-- The conjugate transpose of a real matrix read as a complex matrix is its transpose. -/
theorem conjTranspose_map_ofReal (R : Matrix (Fin 3) (Fin 3) ℝ) :
    (R.map (fun x : ℝ => (x : ℂ)))ᴴ = Rᵀ.map (fun x : ℝ => (x : ℂ)) := by
  ext i j
  simp

/-- The determinant of a real matrix read as a complex matrix. -/
theorem det_map_ofReal (R : Matrix (Fin 3) (Fin 3) ℝ) :
    (R.map (fun x : ℝ => (x : ℂ))).det = R.det :=
  (RingHom.map_det Complex.ofRealHom R).symm

/-- A real matrix of `SO(3)`, read as a complex matrix, lies in `SU(3)`. -/
theorem map_ofReal_mem_specialUnitaryGroup {R : Matrix (Fin 3) (Fin 3) ℝ}
    (hR : R ∈ specialOrthogonalGroup (Fin 3) ℝ) :
    R.map (fun x : ℝ => (x : ℂ)) ∈ specialUnitaryGroup (Fin 3) ℂ := by
  rw [mem_specialOrthogonalGroup_iff, mem_orthogonalGroup_iff] at hR
  rw [mem_specialUnitaryGroup_iff, mem_unitaryGroup_iff]
  refine ⟨?_, ?_⟩
  · rw [star_eq_conjTranspose, conjTranspose_map_ofReal, ← map_ofReal_mul, hR.1]
    exact Matrix.map_one _ Complex.ofReal_zero Complex.ofReal_one
  · rw [det_map_ofReal, hR.2, Complex.ofReal_one]

/-! ### Model I: the cube group -/

/-- The signed permutation matrix with permutation `σ` and signs `s`: in row `i` its entry
is `s i`, in column `σ i`, and its other entries are `0`. -/
def signedPermMatrix (σ : Equiv.Perm (Fin 3)) (s : Fin 3 → ℤˣ) : Matrix (Fin 3) (Fin 3) ℂ :=
  Matrix.of fun i j => if j = σ i then (((s i : ℤˣ) : ℤ) : ℂ) else 0

theorem signedPermMatrix_mul (σ τ : Equiv.Perm (Fin 3)) (s t : Fin 3 → ℤˣ) :
    signedPermMatrix σ s * signedPermMatrix τ t =
      signedPermMatrix (σ.trans τ) (fun i => s i * t (σ i)) := by
  ext i j
  simp only [signedPermMatrix, mul_apply, of_apply, ite_mul, zero_mul, Finset.sum_ite_eq',
    Finset.mem_univ, ite_true, Equiv.trans_apply, Units.val_mul, Int.cast_mul]
  split_ifs <;> simp

theorem signedPermMatrix_one : signedPermMatrix 1 (fun _ => 1) = 1 := by
  ext i j
  simp [signedPermMatrix, one_apply, eq_comm]

theorem star_signedPermMatrix (σ : Equiv.Perm (Fin 3)) (s : Fin 3 → ℤˣ) :
    star (signedPermMatrix σ s) = signedPermMatrix σ.symm (fun i => s (σ.symm i)) := by
  ext i j
  simp only [star_apply, signedPermMatrix, of_apply]
  by_cases h : i = σ j
  · subst h
    simp
  · have h' : j ≠ σ.symm i := fun h'' => h (by rw [h'', Equiv.apply_symm_apply])
    simp [h, h']

/-- **Model I** (Section 12.1, `mm:cube`): the cube group, the twenty-four rotations of the
cube, as the signed permutation matrices of determinant one (Section `sec:group-table`). As a
colour group it is a subgroup of `SU(3)`, and its triplet `3_r` is the inclusion: a rotation
acts on the colour space `ℂ³` by its matrix. -/
def cubeGroup : Subgroup (specialUnitaryGroup (Fin 3) ℂ) where
  carrier := {g | ∃ σ s, (g : Matrix (Fin 3) (Fin 3) ℂ) = signedPermMatrix σ s}
  mul_mem' := by
    rintro g h ⟨σ, s, hg⟩ ⟨τ, t, hh⟩
    exact ⟨σ.trans τ, fun i => s i * t (σ i), by
      rw [Submonoid.coe_mul, hg, hh, signedPermMatrix_mul]⟩
  one_mem' := ⟨1, fun _ => 1, by rw [signedPermMatrix_one]; rfl⟩
  inv_mem' := by
    rintro g ⟨σ, s, hg⟩
    exact ⟨σ.symm, fun i => s (σ.symm i), by
      rw [← star_eq_inv, specialUnitaryGroup.coe_star, hg, star_signedPermMatrix]⟩

/-! ### Model II: the icosahedral group -/

theorem mul_mem_icoRotations {M N : Matrix (Fin 3) (Fin 3) ℝ} (hM : M ∈ icoRotations)
    (hN : N ∈ icoRotations) : M * N ∈ icoRotations :=
  ⟨Submonoid.mul_mem _ hM.1 hN.1, fun w hw => by
    rw [← mulVec_mulVec]
    exact hM.2 _ (hN.2 w hw)⟩

theorem one_mem_icoRotations : (1 : Matrix (Fin 3) (Fin 3) ℝ) ∈ icoRotations :=
  ⟨Submonoid.one_mem _, fun w hw => by rwa [one_mulVec]⟩

theorem icoVertices_finite : icoVertices.Finite := by
  simp only [icoVertices]
  exact Set.toFinite _

/-- The transpose of a rotation of the icosahedron is one: a rotation permutes the twelve
vertices, and its transpose is its inverse. -/
theorem transpose_mem_icoRotations {M : Matrix (Fin 3) (Fin 3) ℝ} (hM : M ∈ icoRotations) :
    Mᵀ ∈ icoRotations := by
  obtain ⟨hSO, hV⟩ := hM
  have hO := (mem_orthogonalGroup_iff' (Fin 3) ℝ).mp (mem_specialOrthogonalGroup_iff.mp hSO).1
  refine ⟨?_, ?_⟩
  · rw [mem_specialOrthogonalGroup_iff, mem_orthogonalGroup_iff, transpose_transpose]
    exact ⟨hO, by rw [det_transpose]; exact (mem_specialOrthogonalGroup_iff.mp hSO).2⟩
  · have hinj : Set.InjOn (fun v => M *ᵥ v) icoVertices := by
      intro v _ w _ h
      have := congrArg (fun u => Mᵀ *ᵥ u) h
      simpa only [mulVec_mulVec, hO, one_mulVec] using this
    have hbij := (icoVertices_finite.injOn_iff_bijOn_of_mapsTo
      (f := fun v => M *ᵥ v) (fun v hv => hV v hv)).mp hinj
    intro v hv
    obtain ⟨w, hw, rfl⟩ := hbij.surjOn hv
    simpa only [mulVec_mulVec, hO, one_mulVec] using hw

/-- **Model II** (Section 12.3, `mm:icosahedron`): the icosahedral group `A₅`, the sixty
rotations of the icosahedron (`icoRotations`, Proposition 12.8), read as complex matrices. As
a colour group it is a subgroup of `SU(3)`, and its triplet `3` is the inclusion. -/
def icoGroup : Subgroup (specialUnitaryGroup (Fin 3) ℂ) where
  carrier := {g | ∃ R ∈ icoRotations,
    (g : Matrix (Fin 3) (Fin 3) ℂ) = R.map (fun x : ℝ => (x : ℂ))}
  mul_mem' := by
    rintro g h ⟨R, hR, hg⟩ ⟨S, hS, hh⟩
    exact ⟨R * S, mul_mem_icoRotations hR hS, by rw [Submonoid.coe_mul, hg, hh, map_ofReal_mul]⟩
  one_mem' := ⟨1, one_mem_icoRotations,
    (Matrix.map_one _ Complex.ofReal_zero Complex.ofReal_one).symm⟩
  inv_mem' := by
    rintro g ⟨R, hR, hg⟩
    refine ⟨Rᵀ, transpose_mem_icoRotations hR, ?_⟩
    rw [← star_eq_inv, specialUnitaryGroup.coe_star, hg, star_eq_conjTranspose,
      conjTranspose_map_ofReal]

/-! ### Refinement I: `C₃ × A₅` -/

/-- **Definition 12.11** (the group `C₃ × A₅` and its triplet). The colour group of
Refinement I is `C₃ × A₅`: the pairs `(ω^j, g)` with `j ∈ {0, 1, 2}` and `g` an icosahedral
rotation, multiplied componentwise. The factor `ω^j` is recorded by `j ∈ ZMod 3`, written
multiplicatively, and `g` is an element of `icoGroup`. -/
@[book "def:mm-centre"]
abbrev C3A5 : Type := Multiplicative (ZMod 3) × icoGroup

/-- `ω^j`, for `j ∈ ZMod 3`, keeps `SU(3)`. -/
theorem omega_pow_smul_mem (j : ℕ) {M : Matrix (Fin 3) (Fin 3) ℂ}
    (hM : M ∈ specialUnitaryGroup (Fin 3) ℂ) :
    Exact.omega ^ j • M ∈ specialUnitaryGroup (Fin 3) ℂ := by
  refine smul_mem_specialUnitaryGroup ?_ ?_ hM
  · rw [map_pow, ← mul_pow, Exact.omega_mul_conj, one_pow]
  · rw [← pow_mul, mul_comm, pow_mul, Exact.omega_pow_three, one_pow]

/-- **Definition 12.11** (the triplet of `C₃ × A₅`): `(ω^j, g) ↦ ω^j g`, a unitary matrix of
determinant `ω^{3j} det g = 1`, with `ω = e^{2πi/3}`. -/
@[book "def:mm-centre"]
noncomputable def C3A5.triplet : C3A5 →* specialUnitaryGroup (Fin 3) ℂ where
  toFun x := ⟨Exact.omega ^ (Multiplicative.toAdd x.1).val •
      ((x.2 : specialUnitaryGroup (Fin 3) ℂ) : Matrix (Fin 3) (Fin 3) ℂ),
    omega_pow_smul_mem _ (x.2 : specialUnitaryGroup (Fin 3) ℂ).2⟩
  map_one' := by
    apply Subtype.ext
    simp [ZMod.val_zero]
  map_mul' x y := by
    apply Subtype.ext
    simp only [Prod.fst_mul, Prod.snd_mul, toAdd_mul, Subgroup.coe_mul, Submonoid.coe_mul]
    rw [ZMod.val_add, Exact.omega_pow_mod, pow_add, smul_mul_smul_comm]

/-- The character of `C₃ × A₅`: `χ(ω^j, g) = Tr (ω^j g) = ω^j χ₃(g)`. -/
noncomputable def C3A5.char (x : C3A5) : ℂ :=
  ((C3A5.triplet x : specialUnitaryGroup (Fin 3) ℂ) : Matrix (Fin 3) (Fin 3) ℂ).trace

/-! ### Refinement II: Valentiner's group -/

/-- The matrix `F = [[1, 0, 0], [0, 0, ω], [0, -ω², 0]]` lies in `SU(3)`. -/
theorem valentinerF_mem :
    !![1, 0, 0; 0, 0, Exact.omega; 0, -Exact.omega ^ 2, 0] ∈ specialUnitaryGroup (Fin 3) ℂ := by
  have h2 : (starRingEnd ℂ) Exact.omega * Exact.omega = 1 := by
    rw [mul_comm]; exact Exact.omega_mul_conj
  rw [mem_specialUnitaryGroup_iff, mem_unitaryGroup_iff]
  refine ⟨?_, ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [mul_apply, Fin.sum_univ_three, star_apply, ← mul_pow, Exact.omega_mul_conj]
  · simp [det_fin_three]
    linear_combination Exact.omega_pow_three

/-- The matrix `F = [[1, 0, 0], [0, 0, ω], [0, -ω², 0]]`, which with `C₃ × A₅` generates
Valentiner's group. -/
noncomputable def valentinerF : specialUnitaryGroup (Fin 3) ℂ :=
  ⟨!![1, 0, 0; 0, 0, Exact.omega; 0, -Exact.omega ^ 2, 0], valentinerF_mem⟩

/-- **Refinement II** (Section 12.5, `mm:valentiner`): Valentiner's group `S(1080)`, the
finite subgroup of `SU(3)` of order `1080` with an irreducible triplet, which contains
`C₃ × A₅` with index `6`. The book does not write its matrices; here it is constructed as the
subgroup of `SU(3)` generated by the triplet image of `C₃ × A₅` (Definition 12.11) and the
matrix `F = valentinerF`. Its triplet is the inclusion. -/
noncomputable def valentiner : Subgroup (specialUnitaryGroup (Fin 3) ℂ) :=
  Subgroup.closure (Set.range C3A5.triplet ∪ {valentinerF})

/-! ### Characters and class tables -/

/-- The character of a colour group `G ≤ SU(3)`, the trace of its triplet: `χ(g) = Tr g`. -/
def colourChar (G : Subgroup (specialUnitaryGroup (Fin 3) ℂ)) (g : G) : ℂ :=
  ((g : specialUnitaryGroup (Fin 3) ℂ) : Matrix (Fin 3) (Fin 3) ℂ).trace

/-- The average of a function over a finite group, `⟨f⟩ = (1/|G|) Σ_g f(g)`. -/
noncomputable def groupAvg (G : Type*) (f : G → ℂ) : ℂ :=
  (Nat.card G : ℂ)⁻¹ * ∑ᶠ g, f g

/-- The pairing of class functions on a finite group,
`⟨ψ, ψ'⟩ = (1/|G|) Σ_g ψ(g) conj(ψ'(g))`. -/
noncomputable def classPairing (G : Type*) (ψ ψ' : G → ℂ) : ℂ :=
  groupAvg G fun g => ψ g * (starRingEnd ℂ) (ψ' g)

/-- The character of the antisymmetric square `Λ²` of a representation with character `χ`:
`g ↦ (χ(g)² - χ(g²))/2`. -/
noncomputable def altSqChar {G : Type*} [Monoid G] (χ : G → ℂ) (g : G) : ℂ :=
  (χ g ^ 2 - χ (g ^ 2)) / 2

/-- The character of the symmetric square `Sym²` of a representation with character `χ`:
`g ↦ (χ(g)² + χ(g²))/2`. -/
noncomputable def symSqChar {G : Type*} [Monoid G] (χ : G → ℂ) (g : G) : ℂ :=
  (χ g ^ 2 + χ (g ^ 2)) / 2

/-- The five conjugacy classes of the cube group, named by what the rotation does to the cube
(Figure `fig:mt-s4-characters`). -/
inductive CubeClass
  | identity
  | edgeHalfTurn
  | faceHalfTurn
  | vertexThirdTurn
  | faceQuarterTurn
  deriving DecidableEq

/-- The five blocks of the cube group: `1`, `sgn`, `2`, `3_s` and `3_r`. -/
inductive CubeBlock
  | one
  | sign
  | two
  | threeS
  | threeR
  deriving DecidableEq

/-- The character table of the cube group (Figure `fig:mt-s4-characters`). -/
def cubeCharTable : CubeBlock → CubeClass → ℂ
  | .one, _ => 1
  | .sign, .identity => 1
  | .sign, .edgeHalfTurn => -1
  | .sign, .faceHalfTurn => 1
  | .sign, .vertexThirdTurn => 1
  | .sign, .faceQuarterTurn => -1
  | .two, .identity => 2
  | .two, .edgeHalfTurn => 0
  | .two, .faceHalfTurn => 2
  | .two, .vertexThirdTurn => -1
  | .two, .faceQuarterTurn => 0
  | .threeS, .identity => 3
  | .threeS, .edgeHalfTurn => 1
  | .threeS, .faceHalfTurn => -1
  | .threeS, .vertexThirdTurn => 0
  | .threeS, .faceQuarterTurn => -1
  | .threeR, .identity => 3
  | .threeR, .edgeHalfTurn => -1
  | .threeR, .faceHalfTurn => -1
  | .threeR, .vertexThirdTurn => 0
  | .threeR, .faceQuarterTurn => 1

open Classical in
/-- The class of a rotation of the cube. Its trace `1 + 2 cos θ`, for a turn by `θ`, gives
the turn: `3` for the identity, `-1` for a half-turn, `0` for a third-turn and `1` for a
quarter-turn. A half-turn is about a face axis, one of the coordinate axes, exactly when its
matrix is diagonal; otherwise it is about an edge axis. -/
noncomputable def cubeClassOf (g : cubeGroup) : CubeClass :=
  if colourChar cubeGroup g = 3 then .identity
  else if colourChar cubeGroup g = -1 then
    (if Matrix.IsDiag ((g : specialUnitaryGroup (Fin 3) ℂ) : Matrix (Fin 3) (Fin 3) ℂ) then
      .faceHalfTurn else .edgeHalfTurn)
  else if colourChar cubeGroup g = 0 then .vertexThirdTurn
  else .faceQuarterTurn

/-- The character of the block `ρ` of the cube group, read off the character table. -/
noncomputable def cubeChar (ρ : CubeBlock) (g : cubeGroup) : ℂ :=
  cubeCharTable ρ (cubeClassOf g)

/-- The five conjugacy classes of the icosahedral group, named by the turn each rotation
makes (Figure `fig:mm-a5-characters`). -/
inductive A5Class
  | identity
  | halfTurn
  | thirdTurn
  | fifthTurn
  | twoFifthsTurn
  deriving DecidableEq

/-- The five blocks of the icosahedral group: `1`, `3`, `3'`, `4` and `5`. -/
inductive A5Block
  | one
  | three
  | three'
  | four
  | five
  deriving DecidableEq

/-- The character table of the icosahedral group (Figure `fig:mm-a5-characters`), with
`φ = (1 + √5)/2`. -/
noncomputable def a5CharTable : A5Block → A5Class → ℂ
  | .one, _ => 1
  | .three, .identity => 3
  | .three, .halfTurn => -1
  | .three, .thirdTurn => 0
  | .three, .fifthTurn => (Real.goldenRatio : ℂ)
  | .three, .twoFifthsTurn => 1 - (Real.goldenRatio : ℂ)
  | .three', .identity => 3
  | .three', .halfTurn => -1
  | .three', .thirdTurn => 0
  | .three', .fifthTurn => 1 - (Real.goldenRatio : ℂ)
  | .three', .twoFifthsTurn => (Real.goldenRatio : ℂ)
  | .four, .identity => 4
  | .four, .halfTurn => 0
  | .four, .thirdTurn => 1
  | .four, .fifthTurn => -1
  | .four, .twoFifthsTurn => -1
  | .five, .identity => 5
  | .five, .halfTurn => 1
  | .five, .thirdTurn => -1
  | .five, .fifthTurn => 0
  | .five, .twoFifthsTurn => 0

open Classical in
/-- The class of an icosahedral rotation, read off its trace `1 + 2 cos θ` for a turn by `θ`:
`3` for the identity, `-1` for a half-turn, `0` for a third-turn, `φ` for a turn by `2π/5` and
`1 - φ` for a turn by `4π/5`. -/
noncomputable def a5ClassOf (g : icoGroup) : A5Class :=
  if colourChar icoGroup g = 3 then .identity
  else if colourChar icoGroup g = -1 then .halfTurn
  else if colourChar icoGroup g = 0 then .thirdTurn
  else if colourChar icoGroup g = (Real.goldenRatio : ℂ) then .fifthTurn
  else .twoFifthsTurn

/-- The character of the block `ρ` of the icosahedral group, read off the character table. -/
noncomputable def a5Char (ρ : A5Block) (g : icoGroup) : ℂ :=
  a5CharTable ρ (a5ClassOf g)

/-- A row of a class table: the number of elements of the class, the order of each of them,
and the trace of the triplet on them. -/
structure ClassRow where
  /-- The number of elements of the class. -/
  size : ℕ
  /-- The order of each element of the class. -/
  order : ℕ
  /-- The trace of the triplet on the class. -/
  trace : ℂ

/-- The class table of `S(1080)` (Figure `fig:mm-s1080-classes`): its seventeen rows in the
order of the figure, column by column, each giving the size of a conjugacy class, the order of
its elements and the trace of the triplet on it; `ω = e^{2πi/3}` and `φ = (1 + √5)/2`. -/
noncomputable def s1080ClassTable : Fin 17 → ClassRow :=
  let ω := Exact.omega
  let φ : ℂ := Real.goldenRatio
  ![⟨1, 1, 3⟩, ⟨45, 2, -1⟩, ⟨1, 3, 3 * ω⟩, ⟨1, 3, 3 * ω ^ 2⟩, ⟨120, 3, 0⟩, ⟨120, 3, 0⟩,
    ⟨90, 4, 1⟩, ⟨72, 5, φ⟩, ⟨72, 5, 1 - φ⟩, ⟨45, 6, -ω ^ 2⟩, ⟨45, 6, -ω⟩, ⟨90, 12, ω ^ 2⟩,
    ⟨90, 12, ω⟩, ⟨72, 15, (1 - φ) * ω⟩, ⟨72, 15, φ * ω ^ 2⟩, ⟨72, 15, φ * ω⟩,
    ⟨72, 15, (1 - φ) * ω ^ 2⟩]

/-! ### Loops traversed several times -/

/-- The `n`-fold loop `γⁿ = γ ⋯ γ`, which runs `n` times round the loop `γ`. -/
def Skeleton.Path.loopPow {X : Skeleton} {v : X.V} (γ : X.Path v v) : ℕ → X.Path v v
  | 0 => .nil v
  | n + 1 => γ.comp (loopPow γ n)

end Artform
