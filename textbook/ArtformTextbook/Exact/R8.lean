import Mathlib.Analysis.Complex.Basic
import Mathlib.NumberTheory.Real.Irrational
import Mathlib.Algebra.Ring.Subring.Basic
import Mathlib.Data.Nat.Prime.Int
import Mathlib.Tactic.LinearCombination
import ArtformTextbook.Meta.Book

/-!
# Exact arithmetic in `R₈ = ℤ[1/√2, ζ] = ℤ[1/2, √2, i]`

The native coefficient ring of the book (Definition 7.1) is
`R₈ = ℤ[1/√2, ζ] = ℤ[1/2, √2, i]`, whose every element has unique coordinates
`a + b√2 + i(c + d√2)` with `a, b, c, d ∈ ℤ[1/2]`, the integers divided by powers of two.

Here a number `a + b√2 + i(c + d√2)` of `ℚ(√2, i)` is the structure `Q4` of its four
rational coordinates, with the ring operations written on coordinates, so that the kernel
computes with them. `Q4.toComplex` is the numerical reading, which takes `√2` to the positive
square root of two and `i` to `Complex.I`; it is a ring map, and it is injective because `√2`
is irrational: the coordinates are unique. `R8` is the subring of the numbers whose four
coordinates lie in `ℤ[1/2]`, and `R8C` is its image in `ℂ`. It is the subring of `ℂ` generated
by `1/2`, `√2` and `i` (`R8C_eq_closure`), and also the one generated by `1/√2` and
`ζ = e^{iπ/4} = (1 + i)/√2` (`R8C_eq_closure_zeta`).

A rational number lies in `R₈` exactly when it lies in `ℤ[1/2]` (`ratCast_mem_R8C_iff`); in
particular `n/24` lies in `R₈` exactly when `3` divides `n` (`intCast_div_24_mem_R8C_iff`).
-/

namespace Artform.Exact

open Complex

/-- A number `a + b√2 + i(c + d√2)` of `ℚ(√2, i)`, given by its four rational coordinates. -/
@[ext]
structure Q4 where
  /-- The rational part of the real part. -/
  a : ℚ
  /-- The coefficient of `√2` in the real part. -/
  b : ℚ
  /-- The rational part of the imaginary part. -/
  c : ℚ
  /-- The coefficient of `√2` in the imaginary part. -/
  d : ℚ
  deriving DecidableEq

namespace Q4

instance : Zero Q4 := ⟨⟨0, 0, 0, 0⟩⟩
instance : One Q4 := ⟨⟨1, 0, 0, 0⟩⟩
instance : Add Q4 := ⟨fun x y => ⟨x.a + y.a, x.b + y.b, x.c + y.c, x.d + y.d⟩⟩
instance : Neg Q4 := ⟨fun x => ⟨-x.a, -x.b, -x.c, -x.d⟩⟩
instance : Sub Q4 := ⟨fun x y => ⟨x.a - y.a, x.b - y.b, x.c - y.c, x.d - y.d⟩⟩

/-- The product, from `√2 · √2 = 2` and `i · i = -1`:
`(a + b√2 + i(c + d√2))(a' + b'√2 + i(c' + d'√2))` has real part
`(a a' + 2 b b' - c c' - 2 d d') + (a b' + b a' - c d' - d c')√2` and imaginary part
`(a c' + 2 b d' + c a' + 2 d b') + (a d' + b c' + c b' + d a')√2`. -/
instance : Mul Q4 :=
  ⟨fun x y => ⟨x.a * y.a + 2 * x.b * y.b - x.c * y.c - 2 * x.d * y.d,
    x.a * y.b + x.b * y.a - x.c * y.d - x.d * y.c,
    x.a * y.c + 2 * x.b * y.d + x.c * y.a + 2 * x.d * y.b,
    x.a * y.d + x.b * y.c + x.c * y.b + x.d * y.a⟩⟩

instance : SMul ℕ Q4 := ⟨fun n x => ⟨n * x.a, n * x.b, n * x.c, n * x.d⟩⟩
instance : SMul ℤ Q4 := ⟨fun n x => ⟨n * x.a, n * x.b, n * x.c, n * x.d⟩⟩
instance : NatCast Q4 := ⟨fun n => ⟨n, 0, 0, 0⟩⟩
instance : IntCast Q4 := ⟨fun n => ⟨n, 0, 0, 0⟩⟩
instance : Pow Q4 ℕ := ⟨fun x n => npowRec n x⟩

@[simp] theorem zero_a : (0 : Q4).a = 0 := rfl
@[simp] theorem zero_b : (0 : Q4).b = 0 := rfl
@[simp] theorem zero_c : (0 : Q4).c = 0 := rfl
@[simp] theorem zero_d : (0 : Q4).d = 0 := rfl
@[simp] theorem one_a : (1 : Q4).a = 1 := rfl
@[simp] theorem one_b : (1 : Q4).b = 0 := rfl
@[simp] theorem one_c : (1 : Q4).c = 0 := rfl
@[simp] theorem one_d : (1 : Q4).d = 0 := rfl
@[simp] theorem add_a (x y : Q4) : (x + y).a = x.a + y.a := rfl
@[simp] theorem add_b (x y : Q4) : (x + y).b = x.b + y.b := rfl
@[simp] theorem add_c (x y : Q4) : (x + y).c = x.c + y.c := rfl
@[simp] theorem add_d (x y : Q4) : (x + y).d = x.d + y.d := rfl
@[simp] theorem neg_a (x : Q4) : (-x).a = -x.a := rfl
@[simp] theorem neg_b (x : Q4) : (-x).b = -x.b := rfl
@[simp] theorem neg_c (x : Q4) : (-x).c = -x.c := rfl
@[simp] theorem neg_d (x : Q4) : (-x).d = -x.d := rfl
@[simp] theorem sub_a (x y : Q4) : (x - y).a = x.a - y.a := rfl
@[simp] theorem sub_b (x y : Q4) : (x - y).b = x.b - y.b := rfl
@[simp] theorem sub_c (x y : Q4) : (x - y).c = x.c - y.c := rfl
@[simp] theorem sub_d (x y : Q4) : (x - y).d = x.d - y.d := rfl
@[simp] theorem mul_a (x y : Q4) :
    (x * y).a = x.a * y.a + 2 * x.b * y.b - x.c * y.c - 2 * x.d * y.d := rfl
@[simp] theorem mul_b (x y : Q4) : (x * y).b = x.a * y.b + x.b * y.a - x.c * y.d - x.d * y.c :=
  rfl
@[simp] theorem mul_c (x y : Q4) :
    (x * y).c = x.a * y.c + 2 * x.b * y.d + x.c * y.a + 2 * x.d * y.b := rfl
@[simp] theorem mul_d (x y : Q4) : (x * y).d = x.a * y.d + x.b * y.c + x.c * y.b + x.d * y.a :=
  rfl
@[simp] theorem nsmul_a (n : ℕ) (x : Q4) : (n • x).a = n * x.a := rfl
@[simp] theorem nsmul_b (n : ℕ) (x : Q4) : (n • x).b = n * x.b := rfl
@[simp] theorem nsmul_c (n : ℕ) (x : Q4) : (n • x).c = n * x.c := rfl
@[simp] theorem nsmul_d (n : ℕ) (x : Q4) : (n • x).d = n * x.d := rfl
@[simp] theorem zsmul_a (n : ℤ) (x : Q4) : (n • x).a = n * x.a := rfl
@[simp] theorem zsmul_b (n : ℤ) (x : Q4) : (n • x).b = n * x.b := rfl
@[simp] theorem zsmul_c (n : ℤ) (x : Q4) : (n • x).c = n * x.c := rfl
@[simp] theorem zsmul_d (n : ℤ) (x : Q4) : (n • x).d = n * x.d := rfl
@[simp] theorem natCast_a (n : ℕ) : (n : Q4).a = n := rfl
@[simp] theorem natCast_b (n : ℕ) : (n : Q4).b = 0 := rfl
@[simp] theorem natCast_c (n : ℕ) : (n : Q4).c = 0 := rfl
@[simp] theorem natCast_d (n : ℕ) : (n : Q4).d = 0 := rfl
@[simp] theorem intCast_a (n : ℤ) : (n : Q4).a = n := rfl
@[simp] theorem intCast_b (n : ℤ) : (n : Q4).b = 0 := rfl
@[simp] theorem intCast_c (n : ℤ) : (n : Q4).c = 0 := rfl
@[simp] theorem intCast_d (n : ℤ) : (n : Q4).d = 0 := rfl

theorem pow_zero' (x : Q4) : x ^ 0 = 1 := rfl
theorem pow_succ' (x : Q4) (n : ℕ) : x ^ (n + 1) = x ^ n * x := rfl

/-- The coordinates make `ℚ(√2, i)` a commutative ring. -/
instance : CommRing Q4 where
  add_assoc x y z := by ext <;> simp [add_assoc]
  zero_add x := by ext <;> simp
  add_zero x := by ext <;> simp
  nsmul n x := n • x
  nsmul_zero x := by ext <;> simp
  nsmul_succ n x := by ext <;> simp <;> ring
  zsmul n x := n • x
  zsmul_zero' x := by ext <;> simp
  zsmul_succ' n x := by ext <;> simp <;> ring
  zsmul_neg' n x := by ext <;> simp [Int.negSucc_eq] <;> ring
  neg_add_cancel x := by ext <;> simp
  add_comm x y := by ext <;> simp [add_comm]
  sub_eq_add_neg x y := by ext <;> simp [sub_eq_add_neg]
  mul_assoc x y z := by ext <;> simp <;> ring
  one_mul x := by ext <;> simp
  mul_one x := by ext <;> simp
  zero_mul x := by ext <;> simp
  mul_zero x := by ext <;> simp
  left_distrib x y z := by ext <;> simp <;> ring
  right_distrib x y z := by ext <;> simp <;> ring
  mul_comm x y := by ext <;> simp <;> ring
  npow n x := x ^ n
  npow_zero x := rfl
  npow_succ n x := rfl
  natCast_zero := by ext <;> simp
  natCast_succ n := by ext <;> simp
  intCast_ofNat n := by ext <;> simp
  intCast_negSucc n := by ext <;> simp [Int.negSucc_eq]

/-- The numerical reading `a + b√2 + i(c + d√2)`, with `√2` the positive square root of two
and `i` the chosen quarter-turn `Complex.I`. -/
noncomputable def toComplexFun (x : Q4) : ℂ :=
  ((x.a : ℝ) + (x.b : ℝ) * Real.sqrt 2 : ℝ) + I * ((x.c : ℝ) + (x.d : ℝ) * Real.sqrt 2 : ℝ)

theorem toComplexFun_re (x : Q4) : (toComplexFun x).re = (x.a : ℝ) + (x.b : ℝ) * Real.sqrt 2 := by
  simp [toComplexFun]

theorem toComplexFun_im (x : Q4) : (toComplexFun x).im = (x.c : ℝ) + (x.d : ℝ) * Real.sqrt 2 := by
  simp [toComplexFun]

/-- The numerical reading as a ring map `ℚ(√2, i) → ℂ`. -/
noncomputable def toComplex : Q4 →+* ℂ where
  toFun := toComplexFun
  map_one' := by
    apply Complex.ext <;> simp [toComplexFun_re, toComplexFun_im]
  map_mul' x y := by
    have h2 : Real.sqrt 2 * Real.sqrt 2 = 2 := Real.mul_self_sqrt (by norm_num)
    apply Complex.ext
    · simp only [toComplexFun_re, Complex.mul_re, toComplexFun_im, mul_a, mul_b]
      push_cast
      linear_combination ((x.d : ℝ) * y.d - x.b * y.b) * h2
    · simp only [toComplexFun_im, Complex.mul_im, toComplexFun_re, mul_c, mul_d]
      push_cast
      linear_combination (-((x.b : ℝ) * y.d + x.d * y.b)) * h2
  map_zero' := by
    apply Complex.ext <;> simp [toComplexFun_re, toComplexFun_im]
  map_add' x y := by
    apply Complex.ext
    · simp only [toComplexFun_re, Complex.add_re, add_a, add_b]
      push_cast
      ring
    · simp only [toComplexFun_im, Complex.add_im, add_c, add_d]
      push_cast
      ring

theorem toComplex_apply (x : Q4) :
    toComplex x = ((x.a : ℝ) + (x.b : ℝ) * Real.sqrt 2 : ℝ) +
      I * ((x.c : ℝ) + (x.d : ℝ) * Real.sqrt 2 : ℝ) := rfl

theorem toComplex_re (x : Q4) : (toComplex x).re = (x.a : ℝ) + (x.b : ℝ) * Real.sqrt 2 :=
  toComplexFun_re x

theorem toComplex_im (x : Q4) : (toComplex x).im = (x.c : ℝ) + (x.d : ℝ) * Real.sqrt 2 :=
  toComplexFun_im x

/-- Rational numbers `p`, `q` with `p + q√2 = 0` are both zero, as `√2` is irrational. -/
theorem eq_zero_of_add_mul_sqrt_two {p q : ℚ} (h : (p : ℝ) + (q : ℝ) * Real.sqrt 2 = 0) :
    p = 0 ∧ q = 0 := by
  have hq : q = 0 := by
    by_contra hq
    apply irrational_sqrt_two.ne_rat (-p / q)
    have hq' : (q : ℝ) ≠ 0 := by exact_mod_cast hq
    push_cast
    field_simp
    linear_combination h
  subst hq
  refine ⟨?_, rfl⟩
  simpa using h

/-- The coordinates are unique: the numerical reading is injective. -/
theorem toComplex_injective : Function.Injective toComplex := by
  intro x y h
  have hre := congrArg Complex.re h
  have him := congrArg Complex.im h
  rw [toComplex_re, toComplex_re] at hre
  rw [toComplex_im, toComplex_im] at him
  obtain ⟨ha, hb⟩ := eq_zero_of_add_mul_sqrt_two (p := x.a - y.a) (q := x.b - y.b) (by
    push_cast
    linear_combination hre)
  obtain ⟨hc, hd⟩ := eq_zero_of_add_mul_sqrt_two (p := x.c - y.c) (q := x.d - y.d) (by
    push_cast
    linear_combination him)
  ext
  · linarith
  · linarith
  · linarith
  · linarith

end Q4

/-- `ℤ[1/2]`: the rational numbers that are integers divided by powers of two. -/
def IsDyadic (q : ℚ) : Prop := ∃ (n : ℤ) (k : ℕ), q = n / 2 ^ k

theorem isDyadic_intCast (n : ℤ) : IsDyadic n := ⟨n, 0, by simp⟩

theorem isDyadic_zero : IsDyadic 0 := ⟨0, 0, by simp⟩

theorem isDyadic_one : IsDyadic 1 := ⟨1, 0, by simp⟩

theorem IsDyadic.add {p q : ℚ} (hp : IsDyadic p) (hq : IsDyadic q) : IsDyadic (p + q) := by
  obtain ⟨m, j, rfl⟩ := hp
  obtain ⟨n, k, rfl⟩ := hq
  refine ⟨m * 2 ^ k + n * 2 ^ j, j + k, ?_⟩
  push_cast
  field_simp
  ring

theorem IsDyadic.mul {p q : ℚ} (hp : IsDyadic p) (hq : IsDyadic q) : IsDyadic (p * q) := by
  obtain ⟨m, j, rfl⟩ := hp
  obtain ⟨n, k, rfl⟩ := hq
  refine ⟨m * n, j + k, ?_⟩
  push_cast
  field_simp
  ring

theorem IsDyadic.neg {p : ℚ} (hp : IsDyadic p) : IsDyadic (-p) := by
  obtain ⟨m, j, rfl⟩ := hp
  exact ⟨-m, j, by push_cast; ring⟩

theorem IsDyadic.sub {p q : ℚ} (hp : IsDyadic p) (hq : IsDyadic q) : IsDyadic (p - q) := by
  rw [sub_eq_add_neg]
  exact hp.add hq.neg

theorem isDyadic_half : IsDyadic (1 / 2) := ⟨1, 1, by norm_num⟩

/-- **Definition 7.1** (native coefficient ring). The coefficients lie in
`R₈ = ℤ[1/√2, ζ] = ℤ[1/2, √2, i]`. Every coefficient has unique coordinates
`a + b√2 + i(c + d√2)` with `a, b, c, d ∈ ℤ[1/2]`, the integers divided by powers of two: `R₈`
is the subring of `Q4` of the numbers whose four coordinates lie in `ℤ[1/2]`. Its numerical
reading (`Q4.toComplex`) takes `√2` to the positive square root of two and `i` to the chosen
quarter-turn; the coordinates are unique because the reading is injective
(`Q4.toComplex_injective`). -/
@[book "qr:ring"]
def R8 : Subring Q4 where
  carrier := {x | IsDyadic x.a ∧ IsDyadic x.b ∧ IsDyadic x.c ∧ IsDyadic x.d}
  mul_mem' := by
    rintro x y ⟨ha, hb, hc, hd⟩ ⟨ha', hb', hc', hd'⟩
    have h2 : IsDyadic 2 := by exact_mod_cast isDyadic_intCast 2
    refine ⟨?_, ?_, ?_, ?_⟩
    · exact (((ha.mul ha').add ((h2.mul hb).mul hb')).sub (hc.mul hc')).sub ((h2.mul hd).mul hd')
    · exact (((ha.mul hb').add (hb.mul ha')).sub (hc.mul hd')).sub (hd.mul hc')
    · exact (((ha.mul hc').add ((h2.mul hb).mul hd')).add (hc.mul ha')).add
        ((h2.mul hd).mul hb')
    · exact (((ha.mul hd').add (hb.mul hc')).add (hc.mul hb')).add (hd.mul ha')
  one_mem' := ⟨isDyadic_one, isDyadic_zero, isDyadic_zero, isDyadic_zero⟩
  add_mem' := by
    rintro x y ⟨ha, hb, hc, hd⟩ ⟨ha', hb', hc', hd'⟩
    exact ⟨ha.add ha', hb.add hb', hc.add hc', hd.add hd'⟩
  zero_mem' := ⟨isDyadic_zero, isDyadic_zero, isDyadic_zero, isDyadic_zero⟩
  neg_mem' := by
    rintro x ⟨ha, hb, hc, hd⟩
    exact ⟨ha.neg, hb.neg, hc.neg, hd.neg⟩

/-- **Definition 7.1** (native coefficient ring), read numerically: `R₈` as a subring of `ℂ`,
the image of the exact ring under its numerical reading. A complex coefficient "lies in `R₈`"
when it lies in `R8C`. -/
@[book "qr:ring"]
noncomputable def R8C : Subring ℂ := R8.map Q4.toComplex

theorem mem_R8C {z : ℂ} : z ∈ R8C ↔ ∃ x ∈ R8, Q4.toComplex x = z := by
  simp [R8C, Subring.mem_map]

/-- `√2` lies in `R₈`. -/
theorem sqrt_two_mem_R8C : ((Real.sqrt 2 : ℝ) : ℂ) ∈ R8C := by
  refine mem_R8C.mpr ⟨⟨0, 1, 0, 0⟩, ⟨isDyadic_zero, isDyadic_one, isDyadic_zero, isDyadic_zero⟩,
    ?_⟩
  rw [Q4.toComplex_apply]
  push_cast
  ring

/-- `i` lies in `R₈`. -/
theorem I_mem_R8C : I ∈ R8C := by
  refine mem_R8C.mpr ⟨⟨0, 0, 1, 0⟩, ⟨isDyadic_zero, isDyadic_zero, isDyadic_one, isDyadic_zero⟩,
    ?_⟩
  rw [Q4.toComplex_apply]
  push_cast
  ring

/-- `1/2` lies in `R₈`. -/
theorem half_mem_R8C : (1 / 2 : ℂ) ∈ R8C := by
  refine mem_R8C.mpr ⟨⟨1 / 2, 0, 0, 0⟩, ⟨isDyadic_half, isDyadic_zero, isDyadic_zero,
    isDyadic_zero⟩, ?_⟩
  rw [Q4.toComplex_apply]
  push_cast
  ring

theorem sqrt_two_mul_self : ((Real.sqrt 2 : ℝ) : ℂ) * ((Real.sqrt 2 : ℝ) : ℂ) = 2 := by
  rw [← Complex.ofReal_mul, Real.mul_self_sqrt (by norm_num)]
  norm_num

theorem sqrt_two_ne_zero : ((Real.sqrt 2 : ℝ) : ℂ) ≠ 0 := by
  exact_mod_cast (Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < 2)).ne'

theorem inv_sqrt_two_eq : ((Real.sqrt 2 : ℝ) : ℂ)⁻¹ = 1 / 2 * ((Real.sqrt 2 : ℝ) : ℂ) := by
  have := sqrt_two_mul_self
  have := sqrt_two_ne_zero
  field_simp
  linear_combination -sqrt_two_mul_self

/-- `1/√2 = √2/2` lies in `R₈`. -/
theorem inv_sqrt_two_mem_R8C : ((Real.sqrt 2 : ℝ) : ℂ)⁻¹ ∈ R8C := by
  rw [inv_sqrt_two_eq]
  exact R8C.mul_mem half_mem_R8C sqrt_two_mem_R8C

/-- `R₈ = ℤ[1/2, √2, i]`: the subring of `ℂ` generated by `1/2`, `√2` and `i`. -/
theorem R8C_eq_closure :
    R8C = Subring.closure {1 / 2, ((Real.sqrt 2 : ℝ) : ℂ), I} := by
  apply le_antisymm
  · intro z hz
    obtain ⟨x, ⟨ha, hb, hc, hd⟩, rfl⟩ := mem_R8C.mp hz
    set T : Subring ℂ := Subring.closure {1 / 2, ((Real.sqrt 2 : ℝ) : ℂ), I}
    have hhalf : (1 / 2 : ℂ) ∈ T := Subring.subset_closure (by simp)
    have hs : ((Real.sqrt 2 : ℝ) : ℂ) ∈ T := Subring.subset_closure (by simp)
    have hI : I ∈ T := Subring.subset_closure (by simp)
    have hdy : ∀ q : ℚ, IsDyadic q → ((q : ℝ) : ℂ) ∈ T := by
      rintro q ⟨n, k, rfl⟩
      have : (((n / 2 ^ k : ℚ) : ℝ) : ℂ) = (n : ℂ) * (1 / 2) ^ k := by
        push_cast
        rw [one_div, inv_pow, div_eq_mul_inv]
      rw [this]
      exact T.mul_mem (intCast_mem T n) (T.pow_mem hhalf k)
    rw [Q4.toComplex_apply]
    push_cast
    exact T.add_mem (T.add_mem (hdy _ ha) (T.mul_mem (hdy _ hb) hs))
      (T.mul_mem hI (T.add_mem (hdy _ hc) (T.mul_mem (hdy _ hd) hs)))
  · rw [Subring.closure_le]
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl
    exacts [half_mem_R8C, sqrt_two_mem_R8C, I_mem_R8C]

/-- `R₈ = ℤ[1/√2, ζ]`: the subring of `ℂ` generated by `1/√2` and the eighth root of unity
`ζ = e^{iπ/4} = (1 + i)/√2`. -/
theorem R8C_eq_closure_zeta :
    R8C = Subring.closure {((Real.sqrt 2 : ℝ) : ℂ)⁻¹, ((Real.sqrt 2 : ℝ) : ℂ)⁻¹ * (1 + I)} := by
  set T : Subring ℂ :=
    Subring.closure {((Real.sqrt 2 : ℝ) : ℂ)⁻¹, ((Real.sqrt 2 : ℝ) : ℂ)⁻¹ * (1 + I)}
  have hi : ((Real.sqrt 2 : ℝ) : ℂ)⁻¹ ∈ T := Subring.subset_closure (by simp)
  have hz : ((Real.sqrt 2 : ℝ) : ℂ)⁻¹ * (1 + I) ∈ T := Subring.subset_closure (by simp)
  have hinv2 : ((Real.sqrt 2 : ℝ) : ℂ)⁻¹ * ((Real.sqrt 2 : ℝ) : ℂ)⁻¹ = 1 / 2 := by
    rw [← mul_inv, sqrt_two_mul_self]
    norm_num
  apply le_antisymm
  · rw [R8C_eq_closure, Subring.closure_le]
    intro w hw
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
    rcases hw with rfl | rfl | rfl
    · rw [← hinv2]
      exact T.mul_mem hi hi
    · have : ((Real.sqrt 2 : ℝ) : ℂ) = 2 * ((Real.sqrt 2 : ℝ) : ℂ)⁻¹ := by
        have := sqrt_two_ne_zero
        field_simp
        linear_combination sqrt_two_mul_self
      rw [this]
      exact T.mul_mem (by exact_mod_cast intCast_mem T 2) hi
    · have : I = (((Real.sqrt 2 : ℝ) : ℂ)⁻¹ * (1 + I)) * (((Real.sqrt 2 : ℝ) : ℂ)⁻¹ * (1 + I)) := by
        rw [mul_mul_mul_comm, hinv2]
        ring_nf
        rw [Complex.I_sq]
        ring
      rw [this]
      exact T.mul_mem hz hz
  · rw [Subring.closure_le]
    intro w hw
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
    rcases hw with rfl | rfl
    · exact inv_sqrt_two_mem_R8C
    · exact R8C.mul_mem inv_sqrt_two_mem_R8C (R8C.add_mem R8C.one_mem I_mem_R8C)

/-- A rational number lies in `R₈` exactly when it lies in `ℤ[1/2]`. -/
theorem ratCast_mem_R8C_iff (q : ℚ) : (q : ℂ) ∈ R8C ↔ IsDyadic q := by
  constructor
  · rintro h
    obtain ⟨x, ⟨ha, -, -, -⟩, hx⟩ := mem_R8C.mp h
    have hre := congrArg Complex.re hx
    rw [Q4.toComplex_re, Complex.ratCast_re] at hre
    obtain ⟨h1, -⟩ := Q4.eq_zero_of_add_mul_sqrt_two (p := x.a - q) (q := x.b) (by
      push_cast
      linear_combination hre)
    rwa [show q = x.a by linarith]
  · intro hq
    refine mem_R8C.mpr ⟨⟨q, 0, 0, 0⟩, ⟨hq, ?_, ?_, ?_⟩, ?_⟩
    · exact isDyadic_zero
    · exact isDyadic_zero
    · exact isDyadic_zero
    · rw [Q4.toComplex_apply]
      push_cast
      ring

/-- `n/24` lies in `R₈` exactly when `3` divides `n`: `R₈` contains halves but not thirds. -/
theorem intCast_div_24_mem_R8C_iff (n : ℤ) : (n / 24 : ℂ) ∈ R8C ↔ (3 : ℤ) ∣ n := by
  have hcast : (n / 24 : ℂ) = ((n / 24 : ℚ) : ℂ) := by push_cast; ring
  rw [hcast, ratCast_mem_R8C_iff]
  constructor
  · rintro ⟨m, k, hm⟩
    have h : (n : ℚ) * 2 ^ k = 24 * m := by
      field_simp at hm
      linear_combination hm
    have h' : n * 2 ^ k = 24 * m := by exact_mod_cast h
    have h3 : (3 : ℤ) ∣ n * 2 ^ k := ⟨8 * m, by rw [h']; ring⟩
    have hp : Prime (3 : ℤ) := Int.prime_three
    exact (hp.dvd_or_dvd h3).resolve_right fun h2 => by
      have := hp.dvd_of_dvd_pow h2
      norm_num at this
  · rintro ⟨m, rfl⟩
    exact ⟨m, 3, by push_cast; ring⟩

end Artform.Exact
