import ArtformScores.LeapfrogClasses

/-!
# The palindromes of the leapfrog phase

The correction to the ledger's T12. A palindrome `L` has `J L J⁻¹ = L⁻¹` with `J = diag(1, -1)`. If
`u` is its primitive eigenvector, then `σ u` and `u J` are primitive eigenvectors of `L⁻¹`, so
`σ u = v (u J)` for a unit `v` with `v σ(v) = 1`. The units of the normalization are the constants
times powers of `s`, `s - 1` and `s - q`, so `v` is `c (s / (s - q))ⁱ (s - 1)ʲ` with
`c² (1 - q)^(j - i) = 1`, and on the fibre it is `± c (r - 1)ⁿ`. For even `n` this lies in
`⟨-1, ρ⟩`. For odd `n`, `1 - q` is a square `w²`, and it lies in `κ ⟨-1, ρ⟩`, with
`κ = (1 - r) / w`.
-/

namespace Artform.Scores.Leapfrog

open Polynomial
open LaurentPolynomial (T T_add T_zero)
open Matrix (SpecialLinearGroup)
open scoped QuadraticAlgebra

variable {F : Type*} [Field F] {q : F} (hq0 : q ≠ 0) (hq1 : q ≠ 1)

/-! ### `σ` is an involution -/

include hq1 in
theorem sigma_invS1 : sigma hq1 (invS1 q) * (1 - qN q) = sN q - 1 := by
  have h := congrArg (sigma hq1) (s1_mul_inv (q := q))
  simp only [map_mul, map_sub, map_one, sigma_s] at h
  rw [sP_sub_one] at h
  have hi := s1_mul_inv (q := q)
  linear_combination (sN q - 1) * h + (-(sigma hq1 (invS1 q) * (1 - qN q))) * hi

theorem sigma_sP : sigma hq1 (sP q) = sN q := by
  have h := sigma_invS1 hq1
  have hu := isUnit_one_sub_q (q := q) hq1
  apply hu.mul_right_inj.mp
  simp only [sP, map_mul, map_sub, sigma_s, sigma_qN]
  have hi := s1_mul_inv (q := q)
  have h3 : (sN q - qN q) * invS1 q - qN q = (1 - qN q) * (sN q * invS1 q) := sP_sub_q
  linear_combination ((1 - qN q) * sigma hq1 (invS1 q)) * h3 +
    ((1 - qN q) * (sN q * invS1 q)) * h + ((1 - qN q) * sN q) * hi

/-- `σ` is an involution. -/
theorem sigma_sigma (y : Norm q) : sigma hq1 (sigma hq1 y) = y := by
  have h : (sigma hq1).comp (sigma hq1) = RingHom.id (Norm q) := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (poles q))
    apply Polynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply, map_C, sigma_const, RingHom.id_apply]
    · have hX : algebraMap F[X] (Norm q) X = sN q := rfl
      simp only [RingHom.comp_apply, hX, sigma_s, sigma_sP, RingHom.id_apply]
  exact RingHom.congr_fun h y

/-! ### The units with their exponents -/

/-- The subgroup of the units generated by the constants, `s`, `s - 1` and `s - q`. -/
theorem exists_exponents (v : (Norm q)ˣ) :
    ∃ (c : Fˣ) (i j k : ℤ), v = constU c * uS q ^ i * uS1 q ^ j * uSq q ^ k := by
  let K₀ : Subgroup (Norm q)ˣ := (Units.map (algebraMap F (Norm q) : F →* Norm q)).range
  let K : Subgroup (Norm q)ˣ :=
    K₀ ⊔ Subgroup.zpowers (uS q) ⊔ Subgroup.zpowers (uS1 q) ⊔ Subgroup.zpowers (uSq q)
  have hv : v ∈ K := by
    refine mem_of_generators (K := K) ?_ ?_ ?_ ?_ v
    · intro c
      exact Subgroup.mem_sup_left (Subgroup.mem_sup_left (Subgroup.mem_sup_left ⟨c, rfl⟩))
    · exact Subgroup.mem_sup_left (Subgroup.mem_sup_left
        (Subgroup.mem_sup_right (Subgroup.mem_zpowers _)))
    · exact Subgroup.mem_sup_left (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))
    · exact Subgroup.mem_sup_right (Subgroup.mem_zpowers _)
  obtain ⟨a₁, ha₁, b₃, hb₃, rfl⟩ := Subgroup.mem_sup.mp hv
  obtain ⟨a₂, ha₂, b₂, hb₂, rfl⟩ := Subgroup.mem_sup.mp ha₁
  obtain ⟨a₃, ha₃, b₁, hb₁, rfl⟩ := Subgroup.mem_sup.mp ha₂
  obtain ⟨c, rfl⟩ := ha₃
  obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp hb₁
  obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp hb₂
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hb₃
  exact ⟨c, i, j, k, rfl⟩

/-- The unit `π = s (s - q) / (s - 1)`. -/
noncomputable def piU (q : F) : (Norm q)ˣ := uS q * uSq q * (uS1 q)⁻¹

theorem constU_eq (c : Fˣ) :
    (constU c : (Norm q)ˣ) = Units.map (algebraMap F (Norm q) : F →* Norm q) c := rfl

/-- `π` has infinite order modulo the constants. -/
theorem pi_zpow_const {b : Fˣ} {a : ℤ} (h : constU b * piU q ^ a = 1) : a = 0 := by
  have hneg : ((-1 : F)) ≠ 0 := neg_ne_zero.mpr one_ne_zero
  obtain ⟨n, rfl | rfl⟩ := a.eq_nat_or_neg
  · -- `b (s (s - q))ⁿ = (s - 1)ⁿ`
    have h1 : constU b * (uS q * uSq q) ^ n = uS1 q ^ n := by
      rw [piU, mul_zpow, zpow_natCast, inv_zpow, zpow_natCast] at h
      calc _ = constU b * ((uS q * uSq q) ^ n * (uS1 q ^ n)⁻¹) * uS1 q ^ n := by
            rw [mul_assoc (constU b), inv_mul_cancel_right]
        _ = uS1 q ^ n := by rw [h, one_mul]
    have h2 := congrArg (fun z : (Norm q)ˣ => (z : Norm q)) h1
    simp only [Units.val_mul, Units.val_pow_eq_pow_val, val_uS, val_uSq, val_uS1, val_constU] at h2
    have h3 : algebraMap F[X] (Norm q) (C (b : F) * (X * (X - C q)) ^ n) =
        algebraMap F[X] (Norm q) ((X - C 1) ^ n) := by
      simp only [map_mul, map_pow, map_sub, map_C, map_one]
      exact h2
    have h4 := congrArg (Polynomial.eval 0) (poly_injective h3)
    by_contra hn
    have hn0 : n ≠ 0 := by
      intro h0
      apply hn
      simp [h0]
    simp [zero_pow hn0] at h4
    exact (pow_ne_zero n hneg) h4.symm
  · -- `b (s - 1)ⁿ = (s (s - q))ⁿ`
    have h1 : constU b * uS1 q ^ n = (uS q * uSq q) ^ n := by
      rw [piU, zpow_neg, mul_zpow, zpow_natCast, inv_zpow, zpow_natCast, mul_inv, inv_inv] at h
      calc _ = constU b * (((uS q * uSq q) ^ n)⁻¹ * uS1 q ^ n) * (uS q * uSq q) ^ n := by
            rw [mul_assoc, mul_assoc, mul_comm (uS1 q ^ n), inv_mul_cancel_left]
        _ = (uS q * uSq q) ^ n := by rw [h, one_mul]
    have h2 := congrArg (fun z : (Norm q)ˣ => (z : Norm q)) h1
    simp only [Units.val_mul, Units.val_pow_eq_pow_val, val_uS, val_uSq, val_uS1, val_constU] at h2
    have h3 : algebraMap F[X] (Norm q) (C (b : F) * (X - C 1) ^ n) =
        algebraMap F[X] (Norm q) ((X * (X - C q)) ^ n) := by
      simp only [map_mul, map_pow, map_sub, map_C, map_one]
      exact h2
    have h4 := congrArg (Polynomial.eval 0) (poly_injective h3)
    by_contra hn
    have hn0 : n ≠ 0 := by
      intro h0
      apply hn
      simp [h0]
    simp [zero_pow hn0] at h4

/-! ### The norm of a unit -/

/-- `σ` on the units. -/
noncomputable def sigU : (Norm q)ˣ →* (Norm q)ˣ := Units.map (sigma hq1 : Norm q →* Norm q)

theorem val_sigU (v : (Norm q)ˣ) :
    ((sigU hq1 v : (Norm q)ˣ) : Norm q) = sigma hq1 (v : Norm q) := rfl

/-- The constant `1 - q`, as a unit of `F`. -/
noncomputable def dF : Fˣ := Units.mk0 (1 - q) (sub_ne_zero.mpr (Ne.symm hq1))

theorem val_constU_dF : ((constU (dF hq1) : (Norm q)ˣ) : Norm q) = 1 - qN q := by
  rw [val_constU, dF, Units.val_mk0, map_sub, map_one]

/-- The norm `v σ(v)`. -/
noncomputable def normU : (Norm q)ˣ →* (Norm q)ˣ := MonoidHom.id _ * sigU hq1

theorem normU_apply (v : (Norm q)ˣ) : normU hq1 v = v * sigU hq1 v := rfl

theorem normU_uS : normU hq1 (uS q) = piU q := by
  ext
  simp only [normU_apply, piU, Units.val_mul, val_sigU, val_uS, sigma_s, val_uSq]
  have hi : (((uS1 q)⁻¹ : (Norm q)ˣ) : Norm q) = invS1 q := rfl
  rw [hi, sP]
  ring

theorem normU_uS1 : normU hq1 (uS1 q) = constU (dF hq1) := by
  ext
  rw [normU_apply, Units.val_mul, val_sigU, val_uS1, map_sub, map_one, sigma_s, sP_sub_one,
    val_constU_dF]
  linear_combination (1 - qN q) * s1_mul_inv (q := q)

theorem normU_uSq : normU hq1 (uSq q) = constU (dF hq1) * piU q := by
  ext
  rw [normU_apply, Units.val_mul, Units.val_mul, val_sigU, val_uSq, map_sub, sigma_s, sigma_qN,
    sP_sub_q, val_constU_dF, piU]
  simp only [Units.val_mul, val_uS, val_uSq]
  have hi : (((uS1 q)⁻¹ : (Norm q)ˣ) : Norm q) = invS1 q := rfl
  rw [hi]
  ring

theorem normU_const (c : Fˣ) : normU hq1 (constU c) = constU (c * c) := by
  ext
  rw [normU_apply, Units.val_mul, val_sigU, val_constU, sigma_const, val_constU, Units.val_mul,
    map_mul]

theorem constU_mul (a b : Fˣ) : (constU (a * b) : (Norm q)ˣ) = constU a * constU b :=
  map_mul (Units.map (algebraMap F (Norm q) : F →* Norm q)) a b

theorem constU_zpow (a : Fˣ) (n : ℤ) : (constU (a ^ n) : (Norm q)ˣ) = constU a ^ n :=
  map_zpow (Units.map (algebraMap F (Norm q) : F →* Norm q)) a n

theorem constU_one : (constU 1 : (Norm q)ˣ) = 1 :=
  map_one (Units.map (algebraMap F (Norm q) : F →* Norm q))

theorem constU_injective : Function.Injective (constU : Fˣ → (Norm q)ˣ) := by
  intro a b h
  have h1 := congrArg (fun z : (Norm q)ˣ => (z : Norm q)) h
  simp only [val_constU] at h1
  exact Units.ext ((algebraMap F (Norm q)).injective h1)

/-- A unit of norm one is a constant times `(s / (s - q))ⁱ (s - 1)ʲ`, with
`c² (1 - q)^(j - i) = 1`. -/
theorem exponents_of_norm_one {v : (Norm q)ˣ} (hN : v * sigU hq1 v = 1) :
    ∃ (c : Fˣ) (i j : ℤ), v = constU c * uS q ^ i * uS1 q ^ j * uSq q ^ (-i) ∧
      c * c * dF hq1 ^ (j - i) = 1 := by
  obtain ⟨c, i, j, k, rfl⟩ := exists_exponents v
  have h1 : normU hq1 (constU c * uS q ^ i * uS1 q ^ j * uSq q ^ k) =
      constU (c * c * dF hq1 ^ (j + k)) * piU q ^ (i + k) := by
    simp only [map_mul, map_zpow, normU_uS, normU_uS1, normU_uSq, normU_const, constU_mul,
      constU_zpow, mul_zpow, zpow_add]
    simp only [mul_comm, mul_left_comm, mul_assoc]
  have h2 : constU (c * c * dF hq1 ^ (j + k)) * piU q ^ (i + k) = 1 := by
    rw [← h1, normU_apply]
    exact hN
  have hik : i + k = 0 := pi_zpow_const h2
  have hk : k = -i := by omega
  subst hk
  refine ⟨c, i, j, rfl, ?_⟩
  rw [hik, zpow_zero, mul_one] at h2
  have h3 : j + -i = j - i := by ring
  rw [h3] at h2
  exact constU_injective (h2.trans constU_one.symm)

/-! ### On the fibre -/

/-- A constant, as a unit of the fibre. -/
noncomputable def constE (c : Fˣ) : (Fib q)ˣ := Units.map (algebraMap F (Fib q) : F →* Fib q) c

theorem val_constE (c : Fˣ) : ((constE c : (Fib q)ˣ) : Fib q) = algebraMap F (Fib q) (c : F) := rfl

theorem constE_mul (a b : Fˣ) : (constE (a * b) : (Fib q)ˣ) = constE a * constE b :=
  map_mul (Units.map (algebraMap F (Fib q) : F →* Fib q)) a b

theorem constE_zpow (a : Fˣ) (n : ℤ) : (constE (a ^ n) : (Fib q)ˣ) = constE a ^ n :=
  map_zpow (Units.map (algebraMap F (Fib q) : F →* Fib q)) a n

theorem epsU_const (c : Fˣ) : epsU hq0 hq1 (constU c) = constE c :=
  Units.ext (eps_const hq0 hq1 (c : F))

/-- The unit `r - 1` of the fibre. -/
noncomputable abbrev gE : (Fib q)ˣ := epsU hq0 hq1 (uS1 q)

theorem val_gE : ((gE hq0 hq1 : (Fib q)ˣ) : Fib q) = rE - 1 := by
  change eps hq0 hq1 (sN q - 1) = _
  rw [map_sub, map_one, eps_s]

/-- `(r - 1)² = ρ (1 - q)`. -/
theorem gE_sq : gE hq0 hq1 * gE hq0 hq1 =
    (rhoU hq0 hq1 : (Fib q)ˣ) * constE (dF hq1) := by
  ext1
  rw [Units.val_mul, Units.val_mul, val_gE, val_constE, dF, Units.val_mk0, map_sub, map_one]
  have h := val_rhoU hq0 hq1
  have hr := rE_mul_self (q := q)
  linear_combination ((1 : Fib q) - rE) * (-h) +
    (((rhoU hq0 hq1 : (Fib q)ˣ) : Fib q)) * (-hr)

/-- On the fibre, `s / (s - q)` is `-1 / (r - 1)`. -/
theorem epsU_uS_div : epsU hq0 hq1 (uS q) * (epsU hq0 hq1 (uSq q))⁻¹ = -1 * (gE hq0 hq1)⁻¹ := by
  have h : epsU hq0 hq1 (uS q) * gE hq0 hq1 = -epsU hq0 hq1 (uSq q) := by
    ext1
    rw [Units.val_mul, val_gE, Units.val_neg]
    have h1 : ((epsU hq0 hq1 (uS q) : (Fib q)ˣ) : Fib q) = rE := eps_s hq0 hq1
    have h2 : ((epsU hq0 hq1 (uSq q) : (Fib q)ˣ) : Fib q) = rE - algebraMap F (Fib q) q := by
      change eps hq0 hq1 (sN q - qN q) = _
      rw [map_sub, eps_s, eps_qN]
    rw [h1, h2]
    linear_combination rE_mul_self (q := q)
  have h3 : epsU hq0 hq1 (uSq q) = -(epsU hq0 hq1 (uS q) * gE hq0 hq1) := by
    rw [h, neg_neg]
  rw [h3, inv_neg, mul_inv, neg_one_mul]
  rw [mul_neg, mul_inv_cancel_left]

/-- A unit of norm one is, on the fibre, `± c (r - 1)ⁿ` with `c² (1 - q)ⁿ = 1`. -/
theorem eps_of_norm_one {v : (Norm q)ˣ} (hN : v * sigU hq1 v = 1) :
    ∃ (c : Fˣ) (e : (Fib q)ˣ) (n : ℤ), (e = 1 ∨ e = -1) ∧ c * c * dF hq1 ^ n = 1 ∧
      epsU hq0 hq1 v = constE c * e * gE hq0 hq1 ^ n := by
  obtain ⟨c, i, j, rfl, hc⟩ := exponents_of_norm_one hq1 hN
  refine ⟨c, (-1) ^ i, j - i, ?_, hc, ?_⟩
  · rcases Int.even_or_odd i with he | ho
    · exact Or.inl he.neg_one_zpow
    · exact Or.inr ho.neg_one_zpow
  · have h1 : epsU hq0 hq1 (uS q) ^ i * epsU hq0 hq1 (uSq q) ^ (-i) =
        (-1) ^ i * gE hq0 hq1 ^ (-i) := by
      rw [zpow_neg, ← inv_zpow, ← mul_zpow, epsU_uS_div, mul_zpow, inv_zpow, zpow_neg]
    simp only [map_mul, map_zpow, epsU_const]
    calc constE c * epsU hq0 hq1 (uS q) ^ i * gE hq0 hq1 ^ j * epsU hq0 hq1 (uSq q) ^ (-i)
        = constE c * (epsU hq0 hq1 (uS q) ^ i * epsU hq0 hq1 (uSq q) ^ (-i)) *
            gE hq0 hq1 ^ j := by
          ac_rfl
      _ = constE c * (-1) ^ i * (gE hq0 hq1 ^ (-i) * gE hq0 hq1 ^ j) := by
          rw [h1]
          ac_rfl
      _ = _ := by rw [← zpow_add, neg_add_eq_sub]

/-! ### The class of `κ` -/

include hq0 hq1 in
/-- `-(1 + w)` is not a root of `q`. -/
theorem kappa_ne {w : F} (h2 : (2 : F) ≠ 0) (hw : w * w = 1 - q) :
    (-(1 + w)) * (-(1 + w)) ≠ q := by
  intro h
  have hw0 : w ≠ 0 := by
    rintro rfl
    apply hq1
    linear_combination hw
  have h1w : 1 + w ≠ 0 := by
    intro h3
    apply hq0
    have h4 : w = -1 := by linear_combination h3
    rw [h4] at hw
    linear_combination hw
  have h5 : 2 * (w * (1 + w)) = 0 := by linear_combination h + hw
  exact mul_ne_zero h2 (mul_ne_zero hw0 h1w) h5

/-- The unit `z = r - (1 + w)`. -/
noncomputable def zKappa {w : F} (h2 : (2 : F) ≠ 0) (hw : w * w = 1 - q) : (Fib q)ˣ :=
  (isUnit_y_add_rE (kappa_ne hq0 hq1 h2 hw)).unit

theorem val_zKappa {w : F} (h2 : (2 : F) ≠ 0) (hw : w * w = 1 - q) :
    ((zKappa hq0 hq1 h2 hw : (Fib q)ˣ) : Fib q) = algebraMap F (Fib q) (-(1 + w)) + rE := rfl

/-- `z / z̄` is `κ = (1 - r) / w`. -/
theorem theta_zKappa {w : F} (h2 : (2 : F) ≠ 0) (hw : w * w = 1 - q) :
    thetaV (zKappa hq0 hq1 h2 hw) * algebraMap F (Fib q) w = 1 - rE := by
  have h := thetaV_mul_star (zKappa hq0 hq1 h2 hw)
  have hu := isUnit_star (zKappa hq0 hq1 h2 hw)
  rw [val_zKappa] at h hu
  apply hu.mul_left_inj.mp
  have hs : star (algebraMap F (Fib q) (-(1 + w)) + rE) =
      algebraMap F (Fib q) (-(1 + w)) - rE := by
    ext <;> simp [rE]
  rw [hs] at h ⊢
  have hr := rE_mul_self (q := q)
  have hW : algebraMap F (Fib q) w * algebraMap F (Fib q) w = 1 - algebraMap F (Fib q) q := by
    rw [← map_mul, hw, map_sub, map_one]
  simp only [map_neg, map_add, map_one] at h ⊢
  linear_combination algebraMap F (Fib q) w * h - hW - hr

/-- `κ² = ρ`. -/
theorem theta_zKappa_sq {w : F} (h2 : (2 : F) ≠ 0) (hw : w * w = 1 - q) :
    theta (zKappa hq0 hq1 h2 hw) * theta (zKappa hq0 hq1 h2 hw) = rhoU hq0 hq1 := by
  have hk := theta_zKappa hq0 hq1 h2 hw
  have hρ := gE_sq hq0 hq1
  have hρ' := congrArg (fun z : (Fib q)ˣ => (z : Fib q)) hρ
  simp only [Units.val_mul, val_gE, val_constE, dF, Units.val_mk0] at hρ'
  have hW : algebraMap F (Fib q) w * algebraMap F (Fib q) w = algebraMap F (Fib q) (1 - q) := by
    rw [← map_mul, hw]
  have hw0 : w ≠ 0 := by
    rintro rfl
    apply hq1
    linear_combination hw
  have hWu : IsUnit (algebraMap F (Fib q) w * algebraMap F (Fib q) w) :=
    ((IsUnit.mk0 w hw0).map (algebraMap F (Fib q))).mul ((IsUnit.mk0 w hw0).map _)
  refine Subtype.ext (Units.ext ?_)
  change thetaV (zKappa hq0 hq1 h2 hw) * thetaV (zKappa hq0 hq1 h2 hw) =
    ((rhoU hq0 hq1 : (Fib q)ˣ) : Fib q)
  apply hWu.mul_left_inj.mp
  rw [hW, ← hρ']
  linear_combination (-(thetaV (zKappa hq0 hq1 h2 hw) * thetaV (zKappa hq0 hq1 h2 hw))) * hW +
    (thetaV (zKappa hq0 hq1 h2 hw) * algebraMap F (Fib q) w + (1 - rE)) * hk

/-! ### The class of a palindrome -/

include hq0 hq1 in
/-- A sign of the fibre is an element of `⟨-1, ρ⟩`. -/
theorem exists_sign {e : (Fib q)ˣ} (he : e = 1 ∨ e = -1) :
    ∃ x ∈ gluing q, (x : (Fib q)ˣ) = e := by
  rcases he with rfl | rfl
  · exact ⟨1, one_mem _, rfl⟩
  · exact ⟨negU hq0 hq1, negU_mem hq0 hq1, Units.ext (by
      rw [val_negU, Units.val_neg, Units.val_one])⟩

theorem const_sign {f : Fˣ} (hf : f * f = 1) :
    (constE f : (Fib q)ˣ) = 1 ∨ (constE f : (Fib q)ˣ) = -1 := by
  have h : (f : F) * (f : F) = 1 := by
    rw [← Units.val_mul, hf, Units.val_one]
  have h1 : ((f : F) - 1) * ((f : F) + 1) = 0 := by linear_combination h
  rcases mul_eq_zero.mp h1 with h2 | h2
  · left
    ext1
    rw [val_constE, sub_eq_zero.mp h2, map_one, Units.val_one]
  · right
    ext1
    have h3 : (f : F) = -1 := by linear_combination h2
    rw [val_constE, h3, map_neg, map_one, Units.val_neg, Units.val_one]

theorem sign_mul {e e' : (Fib q)ˣ} (he : e = 1 ∨ e = -1) (he' : e' = 1 ∨ e' = -1) :
    e * e' = 1 ∨ e * e' = -1 := by
  rcases he with rfl | rfl <;> rcases he' with rfl | rfl <;> simp

theorem sign_neg {e : (Fib q)ˣ} (he : e = 1 ∨ e = -1) : -e = 1 ∨ -e = -1 := by
  rcases he with rfl | rfl <;> simp

/-- The unit `A` whose inverse is, on the fibre, a sign times a unit of norm one lies in `⟨-1, ρ⟩`
or in the coset of `κ`. -/
theorem class_of_norm_one (h2 : (2 : F) ≠ 0) (A : U q) {v : (Norm q)ˣ}
    (hN : v * sigU hq1 v = 1) {e' : (Fib q)ˣ} (he' : e' = 1 ∨ e' = -1)
    (hA : ((A⁻¹ : U q) : (Fib q)ˣ) = e' * epsU hq0 hq1 v) :
    A ∈ gluing q ∨ ∃ (w : F) (hw : w * w = 1 - q),
      (theta (zKappa hq0 hq1 h2 hw))⁻¹ * A ∈ gluing q := by
  obtain ⟨c, e, n, he, hc, hv⟩ := eps_of_norm_one hq0 hq1 hN
  rw [hv] at hA
  have hgpow : ∀ m : ℤ, gE hq0 hq1 ^ (m + m) =
      ((rhoU hq0 hq1 : (Fib q)ˣ)) ^ m * constE (dF hq1 ^ m) := by
    intro m
    rw [zpow_add, ← mul_zpow, gE_sq, mul_zpow, constE_zpow]
  have hs := sign_mul he' he
  rcases Int.even_or_odd' n with ⟨m, rfl | rfl⟩
  · -- `n` even: the class is trivial
    left
    have h2m : 2 * m = m + m := by ring
    rw [h2m] at hA hc
    set f : Fˣ := c * dF hq1 ^ m with hf
    have hff : f * f = 1 := by
      rw [hf]
      calc c * dF hq1 ^ m * (c * dF hq1 ^ m) = c * c * dF hq1 ^ (m + m) := by
            rw [zpow_add]
            ac_rfl
        _ = 1 := hc
    obtain ⟨x, hx, hxv⟩ := exists_sign hq0 hq1 (sign_mul hs (const_sign hff))
    have hA2 : A⁻¹ = x * rhoU hq0 hq1 ^ m := by
      refine Subtype.ext ?_
      rw [hA, hgpow, Subgroup.coe_mul, hxv, Subgroup.coe_zpow, hf, constE_mul]
      ac_rfl
    have hmem : A⁻¹ ∈ gluing q := by
      rw [hA2]
      exact mul_mem hx (zpow_mem (rhoU_mem hq0 hq1) m)
    exact inv_mem_iff.mp hmem
  · -- `n` odd: the class is that of `κ`
    right
    have h2m : 2 * m + 1 = m + m + 1 := by ring
    rw [h2m] at hA hc
    set f : Fˣ := c * dF hq1 ^ m with hf
    have hff : f * f * dF hq1 = 1 := by
      rw [hf]
      calc c * dF hq1 ^ m * (c * dF hq1 ^ m) * dF hq1 = c * c * dF hq1 ^ (m + m + 1) := by
            rw [zpow_add, zpow_add, zpow_one]
            ac_rfl
        _ = 1 := hc
    have hff' : (f : F) * (f : F) * (1 - q) = 1 := by
      have := congrArg (fun z : Fˣ => (z : F)) hff
      simpa [dF] using this
    have hf0 := f.ne_zero
    have hw : (f : F)⁻¹ * (f : F)⁻¹ = 1 - q := by
      field_simp
      linear_combination -hff'
    refine ⟨(f : F)⁻¹, hw, ?_⟩
    set B := theta (zKappa hq0 hq1 h2 hw) with hB
    have hBv := theta_zKappa hq0 hq1 h2 hw
    have hBB : B * B = rhoU hq0 hq1 := theta_zKappa_sq hq0 hq1 h2 hw
    -- `f (r - 1) = -κ`
    have hgB : constE f * gE hq0 hq1 = -(B : (Fib q)ˣ) := by
      ext1
      rw [Units.val_mul, val_constE, val_gE, Units.val_neg]
      have hc' : algebraMap F (Fib q) (f : F) * algebraMap F (Fib q) (f : F)⁻¹ = 1 := by
        rw [← map_mul, mul_inv_cancel₀ hf0, map_one]
      change _ = -thetaV (zKappa hq0 hq1 h2 hw)
      linear_combination algebraMap F (Fib q) (f : F) * hBv -
        thetaV (zKappa hq0 hq1 h2 hw) * hc'
    obtain ⟨x, hx, hxv⟩ := exists_sign hq0 hq1 (sign_neg hs)
    have hA2 : A⁻¹ = x * (rhoU hq0 hq1 ^ m * B) := by
      refine Subtype.ext ?_
      rw [hA, zpow_add, zpow_one, hgpow, Subgroup.coe_mul, hxv, Subgroup.coe_mul,
        Subgroup.coe_zpow]
      have hgB' : constE (c * dF hq1 ^ m) * gE hq0 hq1 = -(B : (Fib q)ˣ) := hgB
      rw [constE_mul] at hgB'
      have hB' : (B : (Fib q)ˣ) = -(constE c * constE (dF hq1 ^ m) * gE hq0 hq1) := by
        rw [hgB', neg_neg]
      rw [hB']
      simp only [mul_neg, neg_mul, neg_neg]
      ac_rfl
    have hA3 : A = (x * (rhoU hq0 hq1 ^ m * B))⁻¹ := by rw [← hA2, inv_inv]
    have h3 : B⁻¹ * A = (x * rhoU hq0 hq1 ^ m * rhoU hq0 hq1)⁻¹ := by
      rw [hA3, ← hBB]
      group
    rw [h3]
    exact inv_mem (mul_mem (mul_mem hx (zpow_mem (rhoU_mem hq0 hq1) m)) (rhoU_mem hq0 hq1))

variable {L : SpecialLinearGroup (Fin 2) (LaurentPolynomial F)} {u : Fin 2 → Norm q}

/-- For a palindrome, `σ u = v (u J)` with `v σ(v) = 1`, where `J = diag(1, -1)`. -/
theorem palindrome_unit (hpal : L.1 0 0 = L.1 1 1) (he : IsEigen hq0 L.1 u) (hp : Prim u) :
    ∃ v : (Norm q)ˣ, v * sigU hq1 v = 1 ∧ sigma hq1 (u 0) = v * u 0 ∧
      sigma hq1 (u 1) = -((v : Norm q) * u 1) := by
  have hes := he.sigma_inv hq0 hq1
  obtain ⟨h0, h1⟩ := (isEigen_iff hq0).mp he
  have hinv : (L⁻¹ : SpecialLinearGroup (Fin 2) (LaurentPolynomial F)).1 =
      !![L.1 1 1, -L.1 0 1; -L.1 1 0, L.1 0 0] := by
    rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  -- `u J` is an eigenvector of the inverse
  have heJ : IsEigen hq0 (L⁻¹ : SpecialLinearGroup (Fin 2) (LaurentPolynomial F)).1
      ![u 0, -u 1] := by
    rw [isEigen_iff, hinv]
    simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_fin_one, map_neg]
    rw [← hpal]
    rw [← hpal] at h1
    constructor
    · linear_combination h0
    · linear_combination -h1
  have hpJ : Prim (![u 0, -u 1] : Fin 2 → Norm q) := by
    obtain ⟨a0, a1, ha⟩ := hp
    refine ⟨a0, -a1, ?_⟩
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    linear_combination ha
  obtain ⟨v, hv⟩ := eigen_unique hq0 hq1 heJ hpJ hes (hp.map (sigma hq1))
  have hv0 : sigma hq1 (u 0) = v * u 0 := by simpa using hv 0
  have hv1 : sigma hq1 (u 1) = -((v : Norm q) * u 1) := by
    have := hv 1
    simp only [Matrix.cons_val_one, Matrix.cons_val_zero] at this
    linear_combination this
  refine ⟨v, ?_, hv0, hv1⟩
  -- apply `σ` twice
  have h3 := congrArg (sigma hq1) hv0
  have h4 := congrArg (sigma hq1) hv1
  rw [sigma_sigma, map_mul, hv0] at h3
  rw [sigma_sigma, map_neg, map_mul, hv1] at h4
  obtain ⟨a0, a1, ha⟩ := hp
  ext1
  rw [Units.val_mul, val_sigU, Units.val_one]
  linear_combination (-a0) * h3 + (-a1) * h4 + (1 - (v : Norm q) * sigma hq1 (v : Norm q)) * ha

/-- The classes of palindromes: the unglued, the trivial, and that of `κ`. -/
theorem palindrome_class (h2 : (2 : F) ≠ 0) (hpal : L.1 0 0 = L.1 1 1)
    {c : Option (U q ⧸ gluing q)} (h : ClassOf hq0 hq1 L c) :
    c = none ∨ c = some 1 ∨ ∃ (w : F) (hw : w * w = 1 - q),
      c = some (theta (zKappa hq0 hq1 h2 hw) : U q) := by
  obtain ⟨u, he, hp, hd⟩ := h
  cases c with
  | none => exact Or.inl rfl
  | some c =>
    right
    have hd1 : ∃ z, GluedBy hq0 hq1 u z ∧ ((theta z : U q) : U q ⧸ gluing q) = c := hd
    obtain ⟨z, ⟨a, b, h0, h1⟩, rfl⟩ := hd1
    obtain ⟨v, hN, hv0, hv1⟩ := palindrome_unit hq0 hq1 hpal he hp
    have hv0' := congrArg (eps hq0 hq1) hv0
    have hv1' := congrArg (eps hq0 hq1) hv1
    simp only [map_mul, map_neg, eps_sigma, h0, h1, star_smul_fib] at hv0' hv1'
    -- `z̄ = ± (ε v) z`
    obtain ⟨e', he', hstar⟩ : ∃ e' : (Fib q)ˣ, (e' = 1 ∨ e' = -1) ∧
        star (z : Fib q) = ((e' * epsU hq0 hq1 v * z : (Fib q)ˣ) : Fib q) := by
      rcases coef_ne hq0 hq1 hp h0 h1 with ha | hb
      · refine ⟨1, Or.inl rfl, ?_⟩
        have h3 : a • (star (z : Fib q) - eps hq0 hq1 (v : Norm q) * (z : Fib q)) = 0 := by
          rw [smul_sub, hv0', mul_smul_comm, sub_self]
        have h4 := (smul_eq_zero.mp h3).resolve_left ha
        rw [one_mul, Units.val_mul]
        exact sub_eq_zero.mp h4
      · refine ⟨-1, Or.inr rfl, ?_⟩
        have h3 : b • (star (z : Fib q) + eps hq0 hq1 (v : Norm q) * (z : Fib q)) = 0 := by
          rw [smul_add, hv1', mul_smul_comm, neg_add_cancel]
        have h4 := (smul_eq_zero.mp h3).resolve_left hb
        rw [neg_one_mul, Units.val_mul, Units.val_neg]
        change star (z : Fib q) = -(eps hq0 hq1 (v : Norm q)) * (z : Fib q)
        linear_combination h4
    -- so `(z / z̄)⁻¹ = ± ε v`
    have hA : (((theta z)⁻¹ : U q) : (Fib q)ˣ) = e' * epsU hq0 hq1 v := by
      have h5 : ((theta z : U q) : (Fib q)ˣ) * (e' * epsU hq0 hq1 v) = 1 := by
        ext1
        have h6 := thetaV_mul_star z
        rw [hstar] at h6
        apply z.isUnit.mul_left_inj.mp
        rw [Units.val_mul, Units.val_one, one_mul]
        change thetaV z * ((e' * epsU hq0 hq1 v : (Fib q)ˣ) : Fib q) * (z : Fib q) = (z : Fib q)
        rw [mul_assoc, ← Units.val_mul]
        exact h6
      rw [Subgroup.coe_inv]
      exact inv_eq_of_mul_eq_one_right h5
    rcases class_of_norm_one hq0 hq1 h2 (theta z) hN he' hA with hm | ⟨w, hw, hm⟩
    · left
      exact congrArg some ((QuotientGroup.eq_one_iff _).mpr hm)
    · right
      refine ⟨w, hw, congrArg some ?_⟩
      exact (QuotientGroup.eq.mpr hm).symm

/-! ### Palindromes in each of the classes -/

section Palindromes

variable (q) in
/-- The half phase `t / 2`. -/
noncomputable def halfT : LaurentPolynomial F := LaurentPolynomial.C 2⁻¹ * phaseT q

variable (q) in
/-- The law `[[t/2, b], [c, t/2]]`. -/
noncomputable def palLaw {b c : LaurentPolynomial F} (h : halfT q * halfT q - b * c = 1) :
    SpecialLinearGroup (Fin 2) (LaurentPolynomial F) :=
  ⟨!![halfT q, b; c, halfT q], by rw [Matrix.det_fin_two_of]; exact h⟩

theorem C_half (h2 : (2 : F) ≠ 0) :
    (LaurentPolynomial.C 2⁻¹ : LaurentPolynomial F) * 2 = 1 := by
  have h : (LaurentPolynomial.C 2⁻¹ : LaurentPolynomial F) * LaurentPolynomial.C 2 = 1 := by
    rw [← map_mul, inv_mul_cancel₀ h2, map_one]
  rwa [map_ofNat] at h

theorem phase_palLaw (h2 : (2 : F) ≠ 0) {b c : LaurentPolynomial F}
    (h : halfT q * halfT q - b * c = 1) : phase (palLaw q h) = phaseT q := by
  simp only [phase, palLaw, Matrix.trace_fin_two, Matrix.of_apply, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.cons_val', Matrix.cons_val_fin_one, halfT]
  linear_combination phaseT q * C_half h2

theorem palLaw_entries {b c : LaurentPolynomial F} (h : halfT q * halfT q - b * c = 1) :
    (palLaw q h).1 0 0 = (palLaw q h).1 1 1 := rfl

/-- The trivial class holds a palindrome, with `c = 1`. -/
theorem pal_trivial_eq :
    halfT q * halfT q - (halfT q * halfT q - 1) * 1 = (1 : LaurentPolynomial F) := by
  ring

/-- The unglued class holds a palindrome, with `c = δ`. -/
theorem pal_unglued_eq (h2 : (2 : F) ≠ 0) :
    halfT q * halfT q - (LaurentPolynomial.C 2⁻¹ * LaurentPolynomial.C 2⁻¹ * LaurentPolynomial.C q *
      deltaS * T (-1) * (4 - LaurentPolynomial.C q * stencilG F)) * deltaS =
    (1 : LaurentPolynomial F) := by
  have hxy := T_mul_T_neg (F := F)
  have hH := C_half h2
  simp only [halfT, phaseT, deltaS, stencilG]
  linear_combination (LaurentPolynomial.C 2⁻¹ * LaurentPolynomial.C 2⁻¹ * LaurentPolynomial.C q *
      (2 - T 1) * (4 - LaurentPolynomial.C q * (2 - T 1 - T (-1)))) * hxy +
    (2 * LaurentPolynomial.C 2⁻¹ + 1) * hH

/-- The palindrome of the class of `κ`. -/
theorem pal_kappa_eq (h2 : (2 : F) ≠ 0) {x₁ x₂ : F} (h12 : x₁ * x₂ = 1)
    (hsum : q * (x₁ + x₂) = 2 * q - 4) :
    halfT q * halfT q - (LaurentPolynomial.C 2⁻¹ * LaurentPolynomial.C 2⁻¹ * LaurentPolynomial.C q *
      LaurentPolynomial.C q * deltaS * deltaS * (T 1 - LaurentPolynomial.C x₂) * T (-1) * T (-1)) *
      (T 1 - LaurentPolynomial.C x₁) = (1 : LaurentPolynomial F) := by
  have hxy := T_mul_T_neg (F := F)
  have hH := C_half h2
  have h12' : (LaurentPolynomial.C x₁ * LaurentPolynomial.C x₂ : LaurentPolynomial F) = 1 := by
    rw [← map_mul, h12, map_one]
  have hsum' : (LaurentPolynomial.C q * (LaurentPolynomial.C x₁ + LaurentPolynomial.C x₂) :
      LaurentPolynomial F) = 2 * LaurentPolynomial.C q - 4 := by
    have := congrArg (LaurentPolynomial.C : F →+* LaurentPolynomial F) hsum
    simpa [map_mul, map_add, map_sub, map_ofNat] using this
  simp only [halfT, phaseT, deltaS, stencilG]
  set H : LaurentPolynomial F := LaurentPolynomial.C 2⁻¹
  set Q : LaurentPolynomial F := LaurentPolynomial.C q
  set A1 : LaurentPolynomial F := LaurentPolynomial.C x₁
  set A2 : LaurentPolynomial F := LaurentPolynomial.C x₂
  set X : LaurentPolynomial F := T 1
  set Y : LaurentPolynomial F := T (-1)
  linear_combination (H * H * (Q * ((X - 1) * (X - 1)) * Y * (-(4 - 2 * Q + Q * X)) +
      Q * (2 - X) * (4 - Q * (2 - X - Y)))) * hxy +
    (H * H * (Q * ((X - 1) * (X - 1)) * Y) * (-(Q * Y))) * h12' +
    (H * H * (Q * ((X - 1) * (X - 1)) * Y) * (X * Y)) * hsum' +
    (2 * H + 1) * hH

/-- The row `(c, λ - a)` of a law of the phase is an eigenvector. -/
theorem row_eigen {L : SpecialLinearGroup (Fin 2) (LaurentPolynomial F)} (ht : phase L = phaseT q) :
    IsEigen hq0 L.1 ![psi hq0 (L.1 1 0), lamN hq0 - psi hq0 (L.1 0 0)] := by
  obtain ⟨hd, htr⟩ := law_rels hq0 L ht
  have hroot := lam_root hq0
  rw [← htr] at hroot
  refine (isEigen_iff hq0).mpr ⟨?_, ?_⟩
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    ring
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    linear_combination -hd - hroot

/-- A factor of an eigenvector is an eigenvector. -/
theorem IsEigen.of_mul {M : Matrix (Fin 2) (Fin 2) (LaurentPolynomial F)} {g u0 u1 w0 w1 : Norm q}
    (he : IsEigen hq0 M ![w0, w1]) (hg : g ≠ 0) (h0 : w0 = g * u0) (h1 : w1 = g * u1) :
    IsEigen hq0 M ![u0, u1] := by
  obtain ⟨e0, e1⟩ := (isEigen_iff hq0).mp he
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at e0 e1
  rw [h0, h1] at e0 e1
  refine (isEigen_iff hq0).mpr ⟨?_, ?_⟩
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    apply mul_left_cancel₀ hg
    linear_combination e0
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    apply mul_left_cancel₀ hg
    linear_combination e1

/-- `(s - 1) (2 λ - t) = δ (s² - 2 s + q)`. -/
theorem two_lam_sub_phase :
    (sN q - 1) * (2 * lamN hq0 - psi hq0 (phaseT q)) =
      deltaN hq0 * (sN q * sN q - 2 * sN q + qN q) := by
  have hroot := lam_root hq0
  have hlam := lam_mul hq0
  have hdel := delta_rel hq0
  have hs := factors_unit (q := q).1
  apply hs.mul_right_inj.mp
  -- `(t - λ) s (1 - s) = s - q`
  have hA : (psi hq0 (phaseT q) - lamN hq0) * (sN q * (1 - sN q)) = sN q - qN q := by
    linear_combination (-(psi hq0 (phaseT q) - lamN hq0)) * hlam -
      (sN q - qN q) * hroot
  simp only [lamN] at hA hroot ⊢
  linear_combination hA + hdel
  
include hq0 in
/-- The two roots of the phase's factor, `x₁ = -(1 - w)/(1 + w)` and `x₂ = 1/x₁`. -/
theorem kappa_roots {w : F} (hw : w * w = 1 - q) :
    (-(1 - w) / (1 + w)) * (-(1 + w) / (1 - w)) = 1 ∧
    q * (-(1 - w) / (1 + w) + -(1 + w) / (1 - w)) = 2 * q - 4 := by
  have hq : q = (1 + w) * (1 - w) := by linear_combination hw
  have h1 : 1 + w ≠ 0 := left_ne_zero_of_mul (hq ▸ hq0)
  have h3 : 1 - w ≠ 0 := right_ne_zero_of_mul (hq ▸ hq0)
  constructor
  · field_simp
  · rw [hq]
    field_simp
    ring

/-- The palindrome of the class of `κ`. -/
noncomputable def palKappa (h2 : (2 : F) ≠ 0) {w : F} (hw : w * w = 1 - q) :
    SpecialLinearGroup (Fin 2) (LaurentPolynomial F) :=
  palLaw q (pal_kappa_eq h2 (kappa_roots hq0 hw).1 (kappa_roots hq0 hw).2)

section KappaAlgebra

variable {a b X₁ H V pinv : Norm q}

/-- The first entry of the row of the palindrome of `κ`. -/
theorem kappa_first (hab : a * b = qN q) (hsum : a + b = 2) (hXa : X₁ * a = -b)
    (hVs : V * (sN q * (sN q - qN q)) = -X₁) :
    (xU hq0 : Norm q) - X₁ = (sN q - a) * (V * (sN q - a)) := by
  have hu3 : IsUnit (sN q * (sN q - qN q)) := factors_unit.1.mul factors_unit.2.2
  have hrel := xU_rel hq0
  apply hu3.mul_left_inj.mp
  linear_combination hrel - (sN q - a) * (sN q - a) * hVs +
    (-1 + sN q - X₁ * sN q) * hab - (b * sN q) * hsum + (b * sN q - 2 * sN q + a) * hXa

/-- The second entry of the row of the palindrome of `κ`. -/
theorem kappa_second (hab : a * b = qN q) (hsum : a + b = 2) (hH2 : H * 2 = 1) :
    lamN hq0 - H * psi hq0 (phaseT q) =
      (sN q - a) * (H * deltaN hq0 * (sN q - b) * invS1 q) := by
  have hs1 := s1_mul_inv (q := q)
  have htwo := two_lam_sub_phase hq0 (q := q)
  linear_combination (-lamN hq0) * hH2 + (H * invS1 q) * htwo -
    (H * (2 * lamN hq0 - psi hq0 (phaseT q))) * hs1 +
    (H * deltaN hq0 * invS1 q * sN q) * hsum - (H * deltaN hq0 * invS1 q) * hab

/-- The row of the palindrome of `κ` is primitive. -/
theorem kappa_prim {V : (Norm q)ˣ} (hH2 : H * 2 = 1)
    (hpi : pinv * ((qN q - a * a) * (a - b)) = 1) :
    IsCoprime ((V : Norm q) * (sN q - a)) (H * deltaN hq0 * (sN q - b) * invS1 q) := by
  have hVi := Units.inv_mul V
  have hs1 := s1_mul_inv (q := q)
  have hdel := delta_rel hq0
  refine ⟨-(pinv * (-(sN q * sN q) + (b - a) * sN q + (qN q + a * (b - a))) *
      ((V⁻¹ : (Norm q)ˣ) : Norm q)), pinv * 2 * (sN q - 1) * (sN q * (sN q - qN q)), ?_⟩
  linear_combination (-(pinv * (-(sN q * sN q) + (b - a) * sN q + (qN q + a * (b - a))) *
      (sN q - a))) * hVi +
    (pinv * (sN q - b) * ((sN q - 1) * invS1 q) * (deltaN hq0 * (sN q * (sN q - qN q)))) * hH2 +
    (pinv * (sN q - b) * (deltaN hq0 * (sN q * (sN q - qN q)))) * hs1 +
    (pinv * (sN q - b)) * hdel + hpi

end KappaAlgebra

include hq0 hq1 in
/-- The constants of the palindrome of `κ`. -/
theorem kappa_constants (h2 : (2 : F) ≠ 0) {w : F} (hw : w * w = 1 - q) :
    (algebraMap F (Norm q) (1 + w) * algebraMap F (Norm q) (1 - w) = qN q) ∧
    (algebraMap F (Norm q) (1 + w) + algebraMap F (Norm q) (1 - w) = 2) ∧
    (algebraMap F (Norm q) (-(1 - w) / (1 + w)) * algebraMap F (Norm q) (1 + w) =
      -algebraMap F (Norm q) (1 - w)) ∧
    (algebraMap F (Norm q) 2⁻¹ * 2 = 1) ∧
    (algebraMap F (Norm q) ((q - (1 + w) * (1 + w)) * ((1 + w) - (1 - w)))⁻¹ *
      ((qN q - algebraMap F (Norm q) (1 + w) * algebraMap F (Norm q) (1 + w)) *
        (algebraMap F (Norm q) (1 + w) - algebraMap F (Norm q) (1 - w))) = 1) := by
  have hq : q = (1 + w) * (1 - w) := by linear_combination hw
  have h1w : 1 + w ≠ 0 := left_ne_zero_of_mul (hq ▸ hq0)
  have hw0 : w ≠ 0 := by
    rintro rfl
    apply hq1
    linear_combination hw
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [← map_mul, ← hq]
  · rw [← map_add, ← map_ofNat (algebraMap F (Norm q)) 2]
    congr 1
    ring
  · rw [← map_mul, ← map_neg]
    congr 1
    field_simp
  · rw [← map_ofNat (algebraMap F (Norm q)) 2, ← map_mul, inv_mul_cancel₀ h2, map_one]
  · have hp₀ : (q - (1 + w) * (1 + w)) * ((1 + w) - (1 - w)) ≠ 0 := by
      refine mul_ne_zero ?_ ?_
      · intro h0
        exact kappa_ne hq0 hq1 h2 hw (by linear_combination -h0)
      · intro h0
        apply mul_ne_zero h2 hw0
        linear_combination h0
    simp only [← map_mul, ← map_sub]
    rw [inv_mul_cancel₀ hp₀, map_one]

theorem palKappa_lower (h2 : (2 : F) ≠ 0) {w : F} (hw : w * w = 1 - q) :
    (palKappa hq0 h2 hw).1 1 0 = T 1 - LaurentPolynomial.C (-(1 - w) / (1 + w)) := rfl

theorem palKappa_diag (h2 : (2 : F) ≠ 0) {w : F} (hw : w * w = 1 - q) :
    (palKappa hq0 h2 hw).1 0 0 = LaurentPolynomial.C 2⁻¹ * phaseT q := rfl

/-- The palindrome of the class of `κ` has that class. -/
theorem classOf_palKappa (h2 : (2 : F) ≠ 0) {w : F} (hw : w * w = 1 - q) :
    ClassOf hq0 hq1 (palKappa hq0 h2 hw)
      (some (theta (zKappa hq0 hq1 h2 hw) : U q)) := by
  have hq : q = (1 + w) * (1 - w) := by linear_combination hw
  have h1w : 1 + w ≠ 0 := left_ne_zero_of_mul (hq ▸ hq0)
  have h3w : 1 - w ≠ 0 := right_ne_zero_of_mul (hq ▸ hq0)
  obtain ⟨hab, hsum, hXa, hH2, hpi⟩ := kappa_constants hq0 hq1 h2 hw
  have hx₁0 : -(-(1 - w) / (1 + w)) ≠ 0 :=
    neg_ne_zero.mpr (div_ne_zero (neg_ne_zero.mpr h3w) h1w)
  let V : (Norm q)ˣ := constU (Units.mk0 _ hx₁0) * (uS q * uSq q)⁻¹
  have hVs : (V : Norm q) * (sN q * (sN q - qN q)) =
      -algebraMap F (Norm q) (-(1 - w) / (1 + w)) := by
    have h3 : (((uS q * uSq q)⁻¹ : (Norm q)ˣ) : Norm q) * (sN q * (sN q - qN q)) = 1 := by
      have := Units.inv_mul (uS q * uSq q)
      rwa [Units.val_mul, val_uS, val_uSq] at this
    simp only [V, Units.val_mul, val_constU, Units.val_mk0, map_neg]
    linear_combination (-algebraMap F (Norm q) (-(1 - w) / (1 + w))) * h3
  have hg : sN q - algebraMap F (Norm q) (1 + w) ≠ 0 := by
    intro h0
    have h3 : algebraMap F[X] (Norm q) (X - C (1 + w)) = 0 := by
      rw [map_sub, map_C]
      exact h0
    exact X_sub_C_ne_zero (1 + w) (poly_injective (h3.trans (map_zero _).symm))
  have he := row_eigen hq0 (phase_palLaw h2 (pal_kappa_eq h2 (kappa_roots hq0 hw).1
    (kappa_roots hq0 hw).2))
  have he2 : IsEigen hq0 (palKappa hq0 h2 hw).1
      ![(V : Norm q) * (sN q - algebraMap F (Norm q) (1 + w)),
        algebraMap F (Norm q) 2⁻¹ * deltaN hq0 * (sN q - algebraMap F (Norm q) (1 - w)) *
          invS1 q] := by
    refine IsEigen.of_mul hq0 he hg ?_ ?_
    · change psi hq0 ((palKappa hq0 h2 hw).1 1 0) = _
      rw [palKappa_lower, map_sub, psi_T_one, psi_C]
      exact kappa_first hq0 hab hsum hXa hVs
    · change lamN hq0 - psi hq0 ((palKappa hq0 h2 hw).1 0 0) = _
      rw [palKappa_diag, map_mul, psi_C]
      exact kappa_second hq0 hab hsum hH2
  refine ⟨_, he2, kappa_prim hq0 hH2 hpi, ?_⟩
  change ∃ z, GluedBy hq0 hq1 _ z ∧ ((theta z : U q) : U q ⧸ gluing q) = _
  refine ⟨epsU hq0 hq1 V * zKappa hq0 hq1 h2 hw, ⟨1, 0, ?_, ?_⟩, ?_⟩
  · simp only [Matrix.cons_val_zero, map_mul, map_sub, eps_s, one_smul, Units.val_mul]
    rw [val_zKappa, eps_const, map_neg]
    change eps hq0 hq1 (V : Norm q) * _ = eps hq0 hq1 (V : Norm q) * _
    ring
  · simp only [Matrix.cons_val_one, Matrix.cons_val_zero, map_mul, eps_delta, zero_smul,
      mul_zero, zero_mul]
  · rw [map_mul, QuotientGroup.mk_mul,
      (QuotientGroup.eq_one_iff _).mpr (theta_eps_mem hq0 hq1 V)]
    exact one_mul ((theta (zKappa hq0 hq1 h2 hw) : U q) : U q ⧸ gluing q)

/-- The trivial palindrome. -/
noncomputable def palTrivial : SpecialLinearGroup (Fin 2) (LaurentPolynomial F) :=
  palLaw q (pal_trivial_eq (q := q))

/-- The unglued palindrome. -/
noncomputable def palUnglued (h2 : (2 : F) ≠ 0) :
    SpecialLinearGroup (Fin 2) (LaurentPolynomial F) :=
  palLaw q (pal_unglued_eq (q := q) h2)

theorem classOf_palTrivial (h2 : (2 : F) ≠ 0) :
    ClassOf hq0 hq1 (palTrivial (q := q)) (some 1) := by
  refine classOf_of_cyclic hq0 hq1 h2 (phase_palLaw h2 pal_trivial_eq) (v := ![1, 0]) ?_
  have : (cyclicMatrix ((palTrivial (q := q) : SpecialLinearGroup (Fin 2) (LaurentPolynomial F)) :
      Matrix (Fin 2) (Fin 2) (LaurentPolynomial F)) ![1, 0]).det = 1 := by
    simp [cyclicMatrix, Matrix.det_fin_two, Matrix.mulVec, dotProduct, Fin.sum_univ_two,
      palTrivial, palLaw]
  rw [this]
  exact isUnit_one

theorem map_palLaw {b c : LaurentPolynomial F} (h : halfT q * halfT q - b * c = 1)
    (ha : atZero F (halfT q) = 1) (hb : atZero F b = 0) (hc : atZero F c = 0) :
    Matrix.SpecialLinearGroup.map (atZero F) (palLaw q h) = 1 := by
  apply Subtype.ext
  change (!![halfT q, b; c, halfT q] : Matrix (Fin 2) (Fin 2) (LaurentPolynomial F)).map
    (atZero F) = 1
  refine Matrix.ext fun i j => ?_
  fin_cases i <;> fin_cases j
  · exact ha
  · exact hb
  · exact hc
  · exact ha

theorem classOf_palUnglued (h2 : (2 : F) ≠ 0) :
    ClassOf hq0 hq1 (palUnglued (q := q) h2) none := by
  have ht : phase (palUnglued (q := q) h2) = phaseT q := phase_palLaw h2 (pal_unglued_eq h2)
  have h1 := classMap_spec hq0 hq1 ht
  have hg : atZero F (stencilG F) = 0 := atZero_g
  have hdelta : atZero F (deltaS : LaurentPolynomial F) = 0 := by
    simp [deltaS, atZero_T]
  have hhalf : atZero F (halfT q) = 1 := by
    rw [halfT, phaseT, map_mul, map_sub, map_mul, hg, mul_zero, sub_zero, atZero_C, map_ofNat,
      inv_mul_cancel₀ h2]
  have h3 : Matrix.SpecialLinearGroup.map (atZero F) (palUnglued (q := q) h2) = 1 := by
    refine map_palLaw _ hhalf ?_ hdelta
    simp only [map_mul, hdelta, mul_zero, zero_mul]
  have h4 := (classOf_none_iff hq0 hq1 h1).mpr h3
  rwa [h4] at h1

/-- Processing keeps the phase. -/
theorem phase_of_processed {L L' : SpecialLinearGroup (Fin 2) (LaurentPolynomial F)}
    (h : Processed L' L) : phase L' = phase L := by
  obtain ⟨P, hP⟩ := h
  rw [phase, phase, hP, Matrix.trace_mul_cycle, ← Units.val_mul, inv_mul_cancel, Units.val_one,
    Matrix.one_mul]

/-- **T12** (the palindromes of the leapfrog phase). -/
@[ledger "T12"]
theorem leapfrogPalindromes : Statement.leapfrogPalindromes := by
  intro F _ q h2 hq0 hq1 L ht
  constructor
  · rintro ⟨L', hpal, hP⟩
    have ht' : phase L' = phaseT q := (phase_of_processed hP).trans ht
    have h1 := classMap_spec hq0 hq1 ht'
    have h3 := h1.conj hq0 hq1 hP.choose hP.choose_spec
    rcases palindrome_class hq0 hq1 h2 hpal h1 with hc | hc | ⟨w, hw, hc⟩
    · rw [hc] at h3
      exact Or.inl (conj_of_classOf hq0 hq1 h2 (classOf_ungluedLaw hq0 hq1) h3)
    · rw [hc] at h3
      exact Or.inr (Or.inl (conj_of_classOf hq0 hq1 h2 (classOf_companionLaw hq0 hq1) h3))
    · rw [hc] at h3
      refine Or.inr (Or.inr ⟨w, hw, ?_⟩)
      exact conj_of_classOf hq0 hq1 h2
        (classOf_gluedLaw hq0 hq1 (kappa_ne hq0 hq1 h2 hw)) h3
  · rintro (h | h | ⟨w, hw, h⟩)
    · refine ⟨palUnglued (q := q) h2, rfl, ?_⟩
      obtain ⟨P, hP⟩ := h
      exact conj_of_classOf hq0 hq1 h2 (classOf_palUnglued hq0 hq1 h2)
        ((classOf_ungluedLaw hq0 hq1).conj hq0 hq1 P hP)
    · refine ⟨palTrivial (q := q), rfl, ?_⟩
      obtain ⟨P, hP⟩ := h
      exact conj_of_classOf hq0 hq1 h2 (classOf_palTrivial hq0 hq1 h2)
        ((classOf_companionLaw hq0 hq1).conj hq0 hq1 P hP)
    · refine ⟨palKappa hq0 h2 hw, rfl, ?_⟩
      obtain ⟨P, hP⟩ := h
      exact conj_of_classOf hq0 hq1 h2 (classOf_palKappa hq0 hq1 h2 hw)
        ((classOf_gluedLaw hq0 hq1 (kappa_ne hq0 hq1 h2 hw)).conj hq0 hq1 P hP)

end Palindromes

/-! ### A fixed class without a palindrome -/

section Gap

/-- The sixth power is trivial on `⟨-1, ρ⟩` at `(p, κλ) = (11, 8)`. -/
theorem gluing_pow_six : ∀ u ∈ gluing (8 : ZMod 11), u ^ 6 = 1 := by
  have hq1 : (8 : ZMod 11) ≠ 1 := by decide
  have hle : gluing (8 : ZMod 11) ≤ (powMonoidHom 6 : U (8 : ZMod 11) →* U (8 : ZMod 11)).ker := by
    refine (Subgroup.closure_le _).mpr ?_
    rintro u (hu | hu)
    · refine Subtype.ext (Units.ext ?_)
      change ((u : (Fib (8 : ZMod 11))ˣ) : Fib (8 : ZMod 11)) ^ 6 = 1
      rw [hu]
      decide +kernel
    · have hv : ((u : (Fib (8 : ZMod 11))ˣ) : Fib (8 : ZMod 11)) = ⟨5, 5⟩ :=
        (isUnit_one_add_rE hq1).mul_left_inj.mp (hu.trans (by decide +kernel))
      refine Subtype.ext (Units.ext ?_)
      change ((u : (Fib (8 : ZMod 11))ˣ) : Fib (8 : ZMod 11)) ^ 6 = 1
      rw [hv]
      decide +kernel
  exact fun u hu => hle hu

/-- **T12** (a fixed class without a palindrome). -/
@[ledger "T12"]
theorem palindromeGap : Statement.palindromeGap := by
  have h2 : (2 : ZMod 11) ≠ 0 := by decide
  have hq0 : (8 : ZMod 11) ≠ 0 := by decide
  have hq1 : (8 : ZMod 11) ≠ 1 := by decide
  have hy : (5 : ZMod 11) * 5 ≠ 8 := by decide
  have ht := phase_gluedLaw (q := (8 : ZMod 11)) 5
  have hcl := classOf_gluedLaw hq0 hq1 hy
  set z : (Fib (8 : ZMod 11))ˣ := (isUnit_y_add_rE hy).unit with hz
  have hzv : (z : Fib (8 : ZMod 11)) = algebraMap (ZMod 11) (Fib (8 : ZMod 11)) 5 + rE := rfl
  -- `z / z̄ = 9 r`
  have hval : thetaV z = ⟨0, 9⟩ := by
    refine (isUnit_star z).mul_left_inj.mp ((thetaV_mul_star z).trans ?_)
    rw [hzv]
    decide +kernel
  have hmap := classMap_eq hq0 hq1 h2 ht hcl
  -- its sixth power is `-1`
  have hsix : (theta z) ^ 6 ≠ 1 := by
    intro h
    have h1 := congrArg
      (fun u : U (8 : ZMod 11) => ((u : (Fib (8 : ZMod 11))ˣ) : Fib (8 : ZMod 11))) h
    change thetaV z ^ 6 = 1 at h1
    rw [hval] at h1
    exact absurd h1 (by decide +kernel)
  refine ⟨ht, ?_, ?_⟩
  · -- the class is fixed by time reversal
    have hi : phase (gluedLaw (8 : ZMod 11) 5)⁻¹ = phaseT (8 : ZMod 11) := by
      rw [phase_inv, ht]
    have h3 := classMap_eq hq0 hq1 h2 hi ((classMap_spec hq0 hq1 ht).inv hq0 hq1)
    rw [hmap] at h3
    refine (classMap_eq_iff hq0 hq1 h2 ht hi).mp ?_
    rw [hmap, h3]
    refine congrArg some ?_
    have hsq : theta z * theta z ∈ gluing (8 : ZMod 11) := by
      refine Subgroup.subset_closure (Or.inl ?_)
      change thetaV z * thetaV z = -1
      rw [hval]
      decide +kernel
    change ((theta z : U (8 : ZMod 11)) : U (8 : ZMod 11) ⧸ gluing (8 : ZMod 11)) =
      ((theta z : U (8 : ZMod 11)) : U (8 : ZMod 11) ⧸ gluing (8 : ZMod 11))⁻¹
    rw [← QuotientGroup.mk_inv]
    refine QuotientGroup.eq.mpr ?_
    have h6 : (theta z)⁻¹ * (theta z)⁻¹ = (theta z * theta z)⁻¹ := by
      rw [mul_inv]
    rw [h6]
    exact inv_mem hsq
  · -- no palindrome lies in it
    rintro ⟨L', hpal, hP⟩
    rcases (leapfrogPalindromes (ZMod 11) 8 h2 hq0 hq1 _ ht).mp ⟨L', hpal, hP⟩ with
      h | h | ⟨w, hw, h⟩
    · have h4 := (classMap_eq_iff hq0 hq1 h2 phase_ungluedLaw ht).mpr h
      rw [classMap_eq hq0 hq1 h2 phase_ungluedLaw (classOf_ungluedLaw hq0 hq1), hmap] at h4
      exact absurd h4 (by simp)
    · have h4 := (classMap_eq_iff hq0 hq1 h2 phase_companionLaw ht).mpr h
      rw [classMap_eq hq0 hq1 h2 phase_companionLaw (classOf_companionLaw hq0 hq1), hmap] at h4
      have h5 : ((theta z : U (8 : ZMod 11)) : U (8 : ZMod 11) ⧸ gluing (8 : ZMod 11)) = 1 :=
        (Option.some.inj h4).symm
      exact hsix (gluing_pow_six _ ((QuotientGroup.eq_one_iff _).mp h5))
    · have hphase := phase_gluedLaw (q := (8 : ZMod 11)) (-(1 + w))
      have h4 := (classMap_eq_iff hq0 hq1 h2 hphase ht).mpr h
      rw [classMap_eq hq0 hq1 h2 hphase (classOf_gluedLaw hq0 hq1 (kappa_ne hq0 hq1 h2 hw)),
        hmap] at h4
      have hm : (theta (zKappa hq0 hq1 h2 hw))⁻¹ * theta z ∈ gluing (8 : ZMod 11) :=
        QuotientGroup.eq.mp (Option.some.inj h4)
      have h6 := gluing_pow_six _ hm
      have hsq := theta_zKappa_sq hq0 hq1 h2 hw
      have hρv : ((rhoU hq0 hq1 : (Fib (8 : ZMod 11))ˣ) : Fib (8 : ZMod 11)) = ⟨5, 5⟩ :=
        (isUnit_one_add_rE hq1).mul_left_inj.mp ((val_rhoU hq0 hq1).trans (by decide +kernel))
      have hρ3 : rhoU hq0 hq1 ^ 3 = 1 := by
        refine Subtype.ext (Units.ext ?_)
        change ((rhoU hq0 hq1 : (Fib (8 : ZMod 11))ˣ) : Fib (8 : ZMod 11)) ^ 3 = 1
        rw [hρv]
        decide +kernel
      have hk6 : theta (zKappa hq0 hq1 h2 hw) ^ 6 = 1 := by
        calc theta (zKappa hq0 hq1 h2 hw) ^ 6 =
            (theta (zKappa hq0 hq1 h2 hw) * theta (zKappa hq0 hq1 h2 hw)) ^ 3 := by
              rw [mul_pow, ← pow_add]
          _ = 1 := by rw [hsq, hρ3]
      rw [mul_pow, inv_pow, hk6, inv_one, one_mul] at h6
      exact hsix h6

end Gap

end Artform.Scores.Leapfrog
