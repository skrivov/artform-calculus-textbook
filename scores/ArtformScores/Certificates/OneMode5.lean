import ArtformScores.OneMode

/-!
# The certificate of T4 at `p = 5`

Generated by `scripts/one_mode_certificates.py`; do not edit by hand. The coset
table of `H = ⟨X⟩` in the group presented by merging and Whitehead's rule over
`ZMod 5`: 24 rows, the action of `X` and `Y` and of their inverses, a word for
each row, and a justification for each of the 48 edges. The 24 deductions
use 10 relators and take 3 rounds.
-/

namespace Artform.Scores.OneMode.Cert5

open Matrix (SpecialLinearGroup)

/-- The row that `X` takes each row to. -/
def fwdX : List ℕ :=
    [0, 9, 6, 11, 5, 12, 10, 17, 14, 8, 20, 15, 7, 13, 18, 16, 21, 4, 1, 19, 22, 3, 2, 23]

/-- The row that `Y` takes each row to. -/
def fwdY : List ℕ :=
    [1, 2, 3, 4, 0, 5, 23, 6, 7, 15, 10, 22, 11, 12, 13, 19, 16, 9, 18, 20, 17, 8, 14, 21]

/-- The row that `X⁻¹` takes each row to. -/
def bwdX : List ℕ :=
    [0, 18, 22, 21, 17, 4, 2, 12, 9, 1, 6, 3, 5, 13, 8, 11, 15, 7, 14, 19, 10, 16, 20, 23]

/-- The row that `Y⁻¹` takes each row to. -/
def bwdY : List ℕ :=
    [4, 0, 1, 2, 3, 5, 7, 8, 21, 17, 10, 12, 13, 14, 22, 9, 16, 20, 18, 15, 19, 23, 11, 6]

/-- The word of each row, along a breadth-first tree from row `0`, in the letters
`0 = X`, `1 = X⁻¹`, `2 = Y` and `3 = Y⁻¹` (`letterOf`). -/
def words : List (List ℕ) :=
    [[], [2], [2, 2], [3, 3], [3], [3, 0], [2, 2, 0], [3, 1, 1], [2, 0, 0], [2, 0], [2, 2, 0, 0],
     [3, 3, 0], [3, 0, 0], [2, 1, 1, 2], [2, 1, 1], [2, 0, 2], [2, 0, 2, 0], [3, 1], [2, 1],
     [2, 0, 2, 2], [3, 1, 3], [3, 3, 1], [2, 2, 1], [2, 2, 0, 2]]

/-- The justification of each edge `(i, X)` and `(i, Y)`, at index `2 i` and `2 i + 1`. -/
def just : List Coset.Just :=
    [.subgroup, .tree, .tree, .tree, .tree, .deduce 1 1 0 2, .tree, .tree, .tree, .tree, .tree,
     .deduce 1 2 0 3, .tree, .tree, .tree, .deduce 2 2 2 1, .deduce 1 0 1 2, .deduce 2 3 8 9, .tree,
     .tree, .deduce 3 0 2 2, .deduce 1 4 10 9, .deduce 2 4 9 8, .deduce 3 1 11 0, .deduce 1 0 4 2,
     .deduce 2 2 4 3, .deduce 2 2 13 0, .deduce 2 3 17 5, .tree, .tree, .tree, .tree,
     .deduce 3 0 3 3, .deduce 3 2 19 3, .tree, .deduce 1 2 1 1, .tree, .deduce 1 2 18 5,
     .deduce 2 3 18 4, .deduce 2 1 9 2, .deduce 2 3 20 0, .tree, .tree, .deduce 2 2 9 1, .tree,
     .deduce 2 2 14 5, .deduce 2 2 23 0, .deduce 3 1 6 1]

/-- The relators of the deductions. -/
def descs : List (Desc 5) :=
    [.powX, .powY, .rm 1 1 1 (-1) (-1), .rm 2 3 2 2 1, .rm 3 2 (-2) (-2) 1, .rm 4 4 (-1) 1 (-1),
     .rk 1 1 1 (-1) (-1), .rk 2 3 2 2 1, .rk 3 2 (-2) (-2) 1, .rk 4 4 (-1) 1 (-1)]

/-- The certificate. -/
def cert : Coset.Cert Gen where
  n := 24
  fwd a i := match a with
    | .X => fwdX.getD i 0
    | .Y => fwdY.getD i 0
  bwd a i := match a with
    | .X => bwdX.getD i 0
    | .Y => bwdY.getD i 0
  word i := (words.getD i []).map letterOf
  just i a := just.getD (2 * i + match a with | .X => 0 | .Y => 1) .tree
  rels := descs.map Desc.word

/-- T4 at `p = 5`. -/
theorem complete :
    (∀ A : SpecialLinearGroup (Fin 2) (ZMod 5), ∃ v, law 5 v = A) ∧
      ∀ v₁ v₂ : FreeGroup Gen, law 5 v₁ = law 5 v₂ ↔
        PresentedGroup.mk (relators 5) v₁ = PresentedGroup.mk (relators 5) v₂ := by
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  exact complete_of_cert 5 cert descs rfl (by decide +kernel) (by decide +kernel) (by decide)
    (by decide +kernel)

end Artform.Scores.OneMode.Cert5
